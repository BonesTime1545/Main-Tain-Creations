+		local shown = if reloading then math.floor((1 - left / math.max(total, 0.1)) * cap) else mag
+		if shown ~= fx.PipsShown then
+			fx.PipsShown = shown
+			local tint = BLAST_TINT[self.fxTier or 1] or BLAST_TINT[1]
+			for k, pip in fx.Pips do
