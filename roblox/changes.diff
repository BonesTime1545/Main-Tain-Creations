+		end
+	end
+	local corners = {}
+	for _, c in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
+		table.insert(corners, plotCF:PointToWorldSpace(Vector3.new(c[1] * half, 0, c[2] * half)))
