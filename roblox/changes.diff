+		l.CanQuery = false
+		l.CanTouch = false
+		l.CastShadow = false
+		l.Material = Enum.Material.Plastic
+		l.Color = col
+		l.TopSurface = Enum.SurfaceType.Smooth
+		l.BottomSurface = Enum.SurfaceType.Smooth
