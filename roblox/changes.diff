+---------------------------------------------------------------- v2.46 PET PANELS
+--[[
+	Click one of YOUR following pets in the world (a short click, like BuildMode's inspect) -> the
+	PET PANEL: name, rarity, level, form, the whole ability text, its numbers RIGHT NOW (toy
+	buff included, live), the cooldown (seconds + bar, like under the pet's name) and the buttons
+	UPGRADE / EVOLVE / UNEQUIP (PetRequest Upgrade / Evolve / Unequip, the same as the Inventory).
+	The little 🐾 button (bottom left) opens EQUIPPED PETS: every following pet with its live
+	cooldown and a DETAILS button that opens the same pet panel.
+	State comes from attributes: PetsEquipped, PetSlotUids, PetData, PetCD, PetBoost, LeafValue.
+]]
+local UserInputService = game:GetService("UserInputService")
+local HttpService = game:GetService("HttpService")
+
+local function num1(x)
+	return (string.gsub(string.format("%.1f", x), "%.0$", ""))
+end
+local function durText(s) -- a number of seconds from the ability definition
+	if s >= 60 then
+		local m = math.floor(s / 60 + 1e-6)
+		local r = math.floor(s - m * 60 + 0.5)
+		return if r == 0 then m .. " min" else string.format("%d:%02d", m, r)
+	end
+	return num1(s) .. " s"
+end
+local function cdText(s) -- a running countdown
+	s = math.max(s, 0)
+	if s >= 60 then
+		return string.format("%d:%02d", s // 60, math.floor(s % 60))
+	end
+	return num1(s) .. " s"
+end
+local function escRich(t)
+	return (string.gsub(string.gsub(string.gsub(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
+end
+
+local STAT_ORDER = { "Every", "Every2", "Star", "Grow", "Chance", "Chance2", "Bloom", "Wind", "Verdant", "Lucky", "Hasten", "XP", "Boost", "Count", "Cut", "Value", "Mult", "Speed", "Trees", "Power", "Gold", "SlideSpeed", "Duration", "MutChance", "Pay" }
+local STAT_NAME = { Every = "Cooldown", Every2 = "Second cooldown", Star = "Star cooldown", Grow = "Grow cooldown", Chance = "Chance", Chance2 = "Second chance", Bloom = "Bloom chance", Wind = "Wind chance", Verdant = "Verdant chance", Lucky = "Lucky chance", Hasten = "Hasten", XP = "XP bonus", Boost = "Boost", Count = "Items", Cut = "Time cut", Value = "Value", Mult = "Multiplier", Speed = "Speed", Trees = "Trees", Power = "Power", Gold = "Gold", SlideSpeed = "Slide speed", Duration = "Duration", MutChance = "Mutation chance", Pay = "Sell bonus" }
+local STAT_TIME = { Every = true, Every2 = true, Star = true, Grow = true, Duration = true }
+local STAT_PCT = { MutChance = true, Pay = true, Chance = true, Chance2 = true, Bloom = true, Wind = true, Verdant = true, Lucky = true, Hasten = true, XP = true, Boost = true }
+local function statText(key, v)
+	if STAT_TIME[key] then
+		return durText(v)
+	elseif STAT_PCT[key] then
+		return num1(math.floor(v * 1000 + 0.5) / 10) .. "%"
+	elseif key == "Mult" or key == "Speed" or key == "Trees" then
+		if v < 1 then
+			return "+" .. num1(math.floor(v * 1000 + 0.5) / 10) .. "%"
+		end
+		return "×" .. num1(v)
+	elseif key == "Cut" then
+		return string.format("%d:%02d", v // 60, math.floor(v % 60))
+	end
+	return num1(v)
+end
+
+function PetFX:InitPanels(d)
+	if self.panels then
+		return self.panels
+	end
+	local K, P = d.UIKit, self.P
+	local player = Players.LocalPlayer
+	local fmt = d.fmt or tostring
+	local PW = {}
+	self.panels = PW
+	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
+	local WHITE = Color3.new(1, 1, 1)
+
+	local function click()
+		if d.Sfx then
+			pcall(d.Sfx.Play, "Click")
+		end
+	end
+	local function viewH()
+		local cam = workspace.CurrentCamera
+		return if cam then cam.ViewportSize.Y else 720
+	end
+
+	-- ---------------------------------------------------------- attributes (decoded again only when they change)
+	local cacheRaw, cacheVal = {}, {}
+	local function json(name)
+		local raw = player:GetAttribute(name)
+		if cacheVal[name] == nil or raw ~= cacheRaw[name] then
+			cacheRaw[name] = raw
+			local ok, t = pcall(function()
+				return HttpService:JSONDecode(raw or "{}")
+			end)
+			cacheVal[name] = if ok and type(t) == "table" then t else {}
+		end
+		return cacheVal[name]
+	end
+
+	-- the following pets in slot order: { Slot, Uid, Id, Variant, Level, Fav, Def }
+	local lastRaw, lastSlots, lastPd, lastList
+	local function getList()
+		local raw = player:GetAttribute("PetsEquipped") or ""
+		local slotRaw = player:GetAttribute("PetSlotUids") or ""
+		local pdRaw = player:GetAttribute("PetData") or ""
+		if lastList and raw == lastRaw and slotRaw == lastSlots and pdRaw == lastPd then
+			return lastList
+		end
+		lastRaw, lastSlots, lastPd = raw, slotRaw, pdRaw
+		local pd = json("PetData")
+		local uids = {}
+		for u in string.gmatch(slotRaw, "[^,]+") do
+			table.insert(uids, u)
+		end
+		local list, used, missing = {}, {}, {}
+		local slot = 0
+		for entry in string.gmatch(raw, "[^,]+") do
+			local id, variant, level = string.match(entry, "^(%w+):(%w+):(%d+)$")
+			if id then
+				slot += 1
+				local def = P.Pets[id]
+				if def then
+					local uid = uids[slot]
+					local p = uid and pd[uid]
+					if not (type(p) == "table" and p.Id == id and p.Variant == variant and p.Eq == true) then
+						uid = nil
+					end
+					local e = { Slot = slot, Uid = uid, Id = id, Variant = variant, Level = tonumber(level) or 1, Def = def }
+					if uid then
+						used[uid] = true
+					else
+						table.insert(missing, e)
+					end
+					table.insert(list, e)
+				end
+			end
+		end
+		if #missing > 0 then
+			-- (the slot list is a moment late: find the pets by what they are)
+			local cand = {}
+			for uid, p in pd do
+				if type(p) == "table" and p.Eq == true and not used[uid] then
+					table.insert(cand, uid)
+				end
+			end
+			table.sort(cand)
+			for _, e in missing do
+				for i, uid in cand do
+					local p = pd[uid]
+					if p.Id == e.Id and p.Variant == e.Variant and (tonumber(p.Level) or 1) == e.Level then
+						e.Uid = uid
+						table.remove(cand, i)
+						break
+					end
+				end
+			end
