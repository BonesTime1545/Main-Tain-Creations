+				r.stuck = 0
+				r.ang += r.side * r.rng:NextNumber(1.6, 2.6)
+				r.side = -r.side
+				r.reT = now + r.rng:NextNumber(0.8, 1.6)
+			end
+		else
+			r.stuck = math.max(r.stuck - dt, 0)
+		end
+		part.AssemblyLinearVelocity = Vector3.new(wdir.X * speed * ramp, vy, wdir.Z * speed * ramp)
+		part.AssemblyAngularVelocity = Vector3.zero
+		-- upright, facing where it runs
+		local yawGoal = math.atan2(-wdir.X, -wdir.Z)
+		local yaw = r.yaw or yawGoal
+		local dy = (yawGoal - yaw + math.pi) % (math.pi * 2) - math.pi
