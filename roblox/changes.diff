+local function pulsePos(p: any, d: number)
+	local t = if p.drop > 0 then math.clamp(d / p.drop, 0, 1) else 1
+	return Vector3.new(p.origin.X + p.dir.X * d, p.y0 + (p.y1 - p.y0) * t, p.origin.Z + p.dir.Z * d)
+end
