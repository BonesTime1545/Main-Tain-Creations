+-- v2.47: a tree its owner made SOLID (rec.Solid): the visible parts (trunk, canopy, …) collide with walkers
+-- (Default group: the resource lanes never collide with it). Soil, the base, the hitbox, effects and tiny
+-- bits stay walk-through. on=false puts the pass-through back.
+local SOLID_SKIP = { Soil = true, SoilStuds = true, Base = true, Hitbox = true, AuraRing = true, Halo = true, Beam = true, GoldenRing = true, CrownRing = true, RoyalAura = true, Fireflies = true, FallingLeaves = true, GoldDust = true, Snow = true, Embers = true, Bubbles = true, Sparkles = true, Motes = true }
+local function solidEligible(p)
+	return p:IsA("BasePart") and not SOLID_SKIP[p.Name] and p.Transparency < 0.8 and p:GetAttribute("Soil") == nil and p.Size.Magnitude >= 0.6
+end
+function ObjectFactory.SetSolid(model, on)
+	model:SetAttribute("Solid", on == true)
+	for _, p in model:GetDescendants() do
+		if p:IsA("BasePart") then
+			p.CanCollide = on == true and solidEligible(p)
+		end
+	end
+	if on and not model:GetAttribute("SolidHook") then
+		model:SetAttribute("SolidHook", true)
+		model.DescendantAdded:Connect(function(p)
+			if model:GetAttribute("Solid") == true and solidEligible(p) then
+				p.CanCollide = true -- (parts added later: upgrade, growth)
+			end
+		end)
+	end
+end
