+local function clearDecor()
+	for k, rig in decor do
+		pcall(function()
+			rig.part:Destroy()
+		end)
+		decor[k] = nil
+	end
+	if decorFolder then
+		pcall(function()
+			decorFolder:Destroy()
+		end)
+		decorFolder = nil
+	end
+end
