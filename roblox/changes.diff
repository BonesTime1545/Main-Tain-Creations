+-- (re)build the scenery of island `index` for the look of tier `tierIndex`
+function IslandService.ApplyDecor(index, tierIndex)
+	local model = islandModel(index)
+	if not model then
+		return
+	end
+	local old = model:FindFirstChild("Decor")
+	if old then
+		old:Destroy()
+	end
+	local tier = IC().Tiers[tierIndex] or IC().Tiers[1]
+	local build = DECOR[tier.Id]
+	if not build then
+		return
+	end
+	local data = islandSites(index, model)
+	if #data.Sites == 0 then
+		return
+	end
+	local folder = Instance.new("Folder")
+	folder.Name = "Decor"
+	folder:SetAttribute("Tier", tierIndex)
+	local E = newScene(index, folder, tierIndex, data.Sites)
+	local ok, err = pcall(build, E)
+	if not ok then
+		warn("[IslandService] island decor " .. tier.Id .. ": " .. tostring(err))
+	end
+	folder.Parent = model
+end
