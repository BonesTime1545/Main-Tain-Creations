+--[[
+	StoneRain / LavaEruption: rocks (lava: glowing lava bombs) really fall out of the sky
+	around you — a growing mark on the ground, a smoky trail, a tumble, then a burst of dust
+	and flying chips, a ring and a little camera shake when it is close. Pure decoration (the
+	server's own stones are WeatherService's impacts). Capped by the Quality level; the
+	rocks fade away after landing; nothing is left when the weather ends.
+]]
+local ROCK_CAP = { 8, 14, 20 }
+local ROCK_RATE = { 1.3, 2.4, 3.4 }
+local ROCK_GRAY = { Color3.fromRGB(122, 116, 110), Color3.fromRGB(98, 94, 92), Color3.fromRGB(142, 130, 116), Color3.fromRGB(110, 106, 120) }
+local rockRng = Random.new()
+local rockParams = RaycastParams.new()
+rockParams.FilterType = Enum.RaycastFilterType.Exclude
+
+local function rockPart(folder, props)
+	local p = Instance.new("Part")
+	p.Anchored = true
+	p.CanCollide = false
+	p.CanQuery = false
+	p.CanTouch = false
+	p.CastShadow = false
+	p.TopSurface = Enum.SurfaceType.Smooth
+	p.BottomSurface = Enum.SurfaceType.Smooth
+	for key, v in props do
+		(p :: any)[key] = v
+	end
+	p.Parent = folder
+	return p
+end
+
+function WeatherFX:_spawnRock(R, kind, camPos)
+	local ang = rockRng:NextNumber(0, math.pi * 2)
+	local dist = rockRng:NextNumber(16, 95)
+	local char = Players.LocalPlayer.Character
+	rockParams.FilterDescendantsInstances = if char then { R.folder, char } else { R.folder }
+	local hit = workspace:Raycast(camPos + Vector3.new(math.cos(ang) * dist, 150, math.sin(ang) * dist), Vector3.new(0, -330, 0), rockParams)
+	if not hit then
+		return
+	end
+	local lava = kind == "Lava"
+	local ground = hit.Position
+	local size = rockRng:NextNumber(1.5, 3.4)
+	local col = if lava then Color3.fromRGB(255, 96, 24) else ROCK_GRAY[rockRng:NextInteger(1, #ROCK_GRAY)]
+	local rock = rockPart(R.folder, {
+		Size = Vector3.new(size * rockRng:NextNumber(0.8, 1.25), size * rockRng:NextNumber(0.7, 1), size * rockRng:NextNumber(0.8, 1.25)),
+		Material = if lava then Enum.Material.CrackedLava else Enum.Material.Slate,
+		Color = col,
