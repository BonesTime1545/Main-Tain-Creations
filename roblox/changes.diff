+			else
+				segs = {}
+				if left then
+					table.insert(segs, left)
+				end
+				if right then
+					table.insert(segs, right)
+				end
+			end
+		end
+		local last = rows[#rows]
+		local same = last and #last.segs == #segs
+		if same then
+			for k, sg in segs do
+				if math.abs(sg[1] - last.segs[k][1]) > 0.02 or math.abs(sg[2] - last.segs[k][2]) > 0.02 then
+					same = false
+					break
+				end
+			end
+		end
+		if same then
