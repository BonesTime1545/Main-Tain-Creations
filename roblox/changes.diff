+	-- smooth open / close: one number 0..1 (tweened) drives scale, slide and fade
+	local function makeAnim(target, apply)
+		local nv = Instance.new("NumberValue")
+		local A = { open = false, nv = nv }
+		local tw
+		nv.Changed:Connect(apply)
+		function A.Set(on)
+			if A.open == on then
+				return
+			end
+			A.open = on
+			if tw then
+				tw:Cancel()
+			end
+			if on then
+				target.Visible = true
+			end
+			tw = TweenService:Create(nv, if on then TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out) else TweenInfo.new(0.17, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = if on then 1 else 0 })
+			local mine = tw
+			mine.Completed:Connect(function(state)
+				if state == Enum.PlaybackState.Completed and tw == mine and not A.open then
+					target.Visible = false
+					if A.onHidden then
+						A.onHidden()
+					end
+				end
+			end)
+			mine:Play()
+		end
+		return A
+	end
