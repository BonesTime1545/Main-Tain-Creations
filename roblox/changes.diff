+--[[
+	v2.51 NEW ISLAND PANEL: when the island tier goes UP during the session (you bought the next island), a
+	closable pop-up lists what the island opens (menus, trees, eggs, ground blocks) and the NEW difficulties it
+	brings (the lawn gets harder: ToolConfig.GrassIsland), with the next goal. Never shown at login.
+	Close it with the red X, the GOT IT button or a click outside.
+]]
+local function shared(name)
+	local ok, m = pcall(function()
+		return require(game:GetService("ReplicatedStorage"):WaitForChild("LeafRush"):WaitForChild(name, 5))
+	end)
+	return if ok then m else nil
+end
+
+local function shortNumber(n)
+	n = tonumber(n) or 0
+	local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
+	for _, u in units do
+		if n >= u[1] then
+			local v = n / u[1]
+			return (if v >= 100 or v % 1 == 0 then string.format("%d", math.floor(v)) else string.format("%.1f", v)) .. u[2]
+		end
+	end
+	return tostring(math.floor(n))
+end
+
+-- what island `tier` brings: { Unlocks = { {Icon, Text} }, Challenges = { {Icon, Text} } }
+local function newsFor(tier)
+	local IC = deps.IslandConfig
+	local out = { Unlocks = {}, Challenges = {} }
+	local t = IC and IC.Tiers[tier]
+	if not t then
+		return out
+	end
+	local TreeTypes, ToolConfig, PetConfig = shared("TreeTypes"), shared("ToolConfig"), shared("PetConfig")
+	for _, id in t.Trees or {} do
+		local def = TreeTypes and TreeTypes.Get and TreeTypes.Get(id)
+		table.insert(out.Unlocks, { "🌳", string.format("New tree in Build: %s", if def and def.Display then def.Display else id) })
+	end
+	local menus = false
+	local ids = {}
+	for id, f in IC.Features do
+		if f.Tier == tier then
+			table.insert(ids, id)
+		end
+	end
+	table.sort(ids)
+	for _, id in ids do
+		local f = IC.Features[id]
+		table.insert(out.Unlocks, { if f.Menu then "🔓" else "✨", f.Display })
+		menus = menus or f.Menu == true
+	end
+	for _, g in IC.Ground or {} do
+		if g.Tier == tier then
+			table.insert(out.Unlocks, { g.Icon or "🧱", string.format("New ground block for the Editor: %s", g.Display) })
+		end
+	end
+	if PetConfig and PetConfig.Eggs then
+		local names = {}
+		for id, egg in PetConfig.Eggs do
+			if egg.Island == tier and (not PetConfig.ShopEggs or PetConfig.ShopEggs[id]) then
+				table.insert(names, egg.Display or id)
+			end
+		end
+		table.sort(names)
+		for _, n in names do
+			table.insert(out.Unlocks, { "🥚", string.format("New egg in the shop: %s", n) })
+		end
+	end
+	if menus then
+		table.insert(out.Unlocks, { "👉", "A new menu opens when you press 🔓 UNLOCK inside it." })
+	end
+	if #out.Unlocks == 0 then
+		table.insert(out.Unlocks, { "🎨", "A brand new look for your garden island." })
+	end
+	-- the lawn: every island makes it a little harder
+	if ToolConfig and ToolConfig.GrassIsland then
+		local row = ToolConfig.GrassIsland(tier)
+		local prev = if tier > 2 then ToolConfig.GrassIsland(tier - 1) else nil
+		local C = out.Challenges
+		if tier == 2 then
+			table.insert(C, { "🌱", "Grass starts to grow in your garden. Sweep it before it gets thick!" })
+		end
+		if prev == nil or row ~= prev then
+			if prev and row.Tick < prev.Tick then
+				table.insert(C, { "⏩", string.format("Grass grows %d%% faster", math.floor((prev.Tick / row.Tick - 1) * 100 + 0.5)) })
+			end
+			if not prev or row.Max ~= prev.Max then
+				table.insert(C, { "📈", string.format("Up to %d%% of the lawn can be overgrown", math.floor(row.Max * 100 + 0.5)) })
+			end
+			if row.Infect > 0 and (not prev or row.Infect ~= prev.Infect) then
+				table.insert(C, { "🦠", string.format("Thick grass spreads to bare spots (%d%% a step)", math.floor(row.Infect * 100 + 0.5)) })
+			end
+			local s = row.Slow
+			if s and (s[1] > 0 or s[2] > 0 or s[3] > 0) and (not prev or s[1] ~= prev.Slow[1] or s[2] ~= prev.Slow[2] or s[3] ~= prev.Slow[3]) then
+				table.insert(C, { "🐌", string.format("Walking in grass slows you down: %d%% tall, %d%% thick, %d%% overgrown", math.floor(s[1] * 100 + 0.5), math.floor(s[2] * 100 + 0.5), math.floor(s[3] * 100 + 0.5)) })
+			end
+		end
+		if #C == 0 then
+			table.insert(C, { "🌿", "The lawn is as hard as on your last island." })
+		end
+	end
+	local nextT = IC.Tiers[tier + 1]
+	if nextT then
+		table.insert(out.Challenges, { "🎯", string.format("Next island: %s %s at level %d (💰%s)", nextT.Icon, nextT.Display, nextT.Level, shortNumber(nextT.Cost)) })
+	else
+		table.insert(out.Challenges, { "🏆", "This is the last island. Enjoy your garden!" })
+	end
+	return out
+end
