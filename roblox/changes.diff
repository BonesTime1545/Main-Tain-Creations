--- Midas Bunny: a golden carrot — what touches it turns Golden
+-- Midas Bunny: a golden carrot — what touches it turns Golden.
+-- v3.x it is a REAL physical object: an unanchored golden carrot dropped into the yard. It falls, rolls,
+-- is pushed by items and swept by the brooms (same collision lane as the items) and the golden zone
+-- follows it. Network-owned by the player; it vanishes when its time is up.
+local function spawnCarrot(player, plot, at, dur)
+	local ok, body = pcall(function()
+		local C = ctx.Config and ctx.Config.Collision
+		local group = plot.GroupIndex or plot.Index
+		local lane = group
+		if ctx.PlotSystem.LaneOf then
+			lane = ctx.PlotSystem.LaneOf(group)
+		end
+		local parent = (plot.ResourcesFolder and plot.ResourcesFolder.Parent) or workspace
+		local gold, leaf = Color3.fromRGB(255, 190, 40), Color3.fromRGB(110, 220, 90)
+		local function mk(name, shape, size, color, cf, mat)
+			local p = Instance.new("Part")
+			p.Name = name
+			p.Shape = shape
+			p.Size = size
+			p.Color = color
+			p.Material = mat or Enum.Material.Neon
+			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
+			p.CFrame = cf
+			p.CanQuery = false
+			return p
+		end
+		local start = CFrame.new(at + Vector3.new(0, 7, 0)) * CFrame.Angles(0, math.random() * 6.28, math.random() * 0.8)
+		-- a cylinder lying along X: thick end, middle, needle tip, three leaves at the other end
+		local main = mk("GoldenCarrot", Enum.PartType.Cylinder, Vector3.new(1.4, 1.1, 1.1), gold, start)
+		main.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.5, 0.35, 1, 1)
+		local mid = mk("CarrotMid", Enum.PartType.Cylinder, Vector3.new(0.9, 0.75, 0.75), gold, start * CFrame.new(1.1, 0, 0))
+		local tip = mk("CarrotTip", Enum.PartType.Cylinder, Vector3.new(0.7, 0.4, 0.4), gold, start * CFrame.new(1.85, 0, 0))
+		local point = mk("CarrotPoint", Enum.PartType.Ball, Vector3.new(0.28, 0.28, 0.28), gold, start * CFrame.new(2.25, 0, 0))
+		local welded = { mid, tip, point }
+		for k = -1, 1 do
+			table.insert(welded, mk("CarrotLeaf", Enum.PartType.Ball, Vector3.new(0.9, 0.22, 0.3), leaf, start * CFrame.new(-1.05, 0, 0) * CFrame.Angles(0, k * 0.5, k * 0.25) * CFrame.new(-0.35, 0, 0), Enum.Material.SmoothPlastic))
+		end
+		for _, p in welded do
+			p.CanCollide = p.Name ~= "CarrotLeaf"
+			p.Massless = true
+			p.CollisionGroup = if C then C.ResourcePrefix .. lane else "Default"
+			p.Parent = parent
+			local w = Instance.new("WeldConstraint")
+			w.Part0, w.Part1 = main, p
+			w.Parent = p
+		end
+		main.CanCollide = true
+		if C then
+			main.CollisionGroup = C.ResourcePrefix .. lane
+		end
+		main:SetAttribute("PetCarrot", true)
+		main.Parent = parent
+		local light = Instance.new("PointLight")
+		light.Color = gold
+		light.Range = 14
+		light.Brightness = 1.6
+		light.Parent = main
+		local em = Instance.new("ParticleEmitter")
+		em.Color = ColorSequence.new(Color3.fromRGB(255, 235, 140), gold)
+		em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
+		em.Lifetime = NumberRange.new(0.8, 1.4)
+		em.Speed = NumberRange.new(1, 3)
+		em.SpreadAngle = Vector2.new(180, 180)
+		em.Rate = 14
+		em.LightEmission = 1
+		em.Parent = main
+		pcall(function()
+			main:SetNetworkOwner(player)
+		end)
+		main.AssemblyLinearVelocity = Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))
+		task.delay(dur + 0.5, function()
+			for _, p in welded do
+				p:Destroy()
+			end
+			main:Destroy()
+		end)
+		return main
+	end)
+	if ok then
+		return body
+	end
+	warn("[LeafRush] golden carrot: " .. tostring(body))
+	return nil
+end
