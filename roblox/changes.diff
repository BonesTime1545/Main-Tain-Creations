+local function buildDecor(name, lv)
+	local part = anchor(name)
+	local rig = { part = part, level = 0, fades = {}, lv = lv }
+	local function fade(o, a)
+		table.insert(rig.fades, { o = o, a = a })
+		return o
+	end
+	if name == "Rainbow" then
+		local bb = board(part, 620)
+		local segs = RAINBOW_SEGS[lv]
+		for i, col in RAINBOW do
+			local r = 0.43 - (i - 1) * 0.021
+			for sg = 0, segs - 1 do
+				local a0 = (sg + 0.5) / segs * math.pi
+				local f = Instance.new("Frame")
+				f.AnchorPoint = Vector2.new(0.5, 0.5)
+				f.Position = UDim2.fromScale(0.5 + math.cos(a0) * r, 0.78 - math.sin(a0) * r)
+				f.Size = UDim2.fromScale(math.pi * r / segs * 1.12, 0.0235)
+				f.Rotation = math.deg(math.atan2(-math.cos(a0), -math.sin(a0)))
+				f.BorderSizePixel = 0
+				f.BackgroundColor3 = col
+				f.BackgroundTransparency = 1
+				f.ZIndex = 1
+				f.Parent = bb
+				fade(f, 0.5)
+			end
+		end
+		local dir = onDome(0.9, math.rad(20))
+		rig.dist = 640
+		rig.dirFn = function()
+			return dir
+		end
+	else -- the blood moon
+		local bb = board(part, 200)
+		fade(circle(bb, 0.98, Color3.fromRGB(200, 20, 30), 1), 0.07)
+		fade(circle(bb, 0.78, Color3.fromRGB(230, 30, 35), 1), 0.14)
+		local body = fade(circle(bb, 0.5, WHITE, 2), 1)
+		gradient(body, 60, colors(Color3.fromRGB(235, 70, 55), Color3.fromRGB(170, 25, 30), Color3.fromRGB(100, 10, 20)))
+		for _, c in { { 0.36, 0.38, 0.1 }, { 0.6, 0.55, 0.14 }, { 0.46, 0.66, 0.07 }, { 0.62, 0.34, 0.06 } } do
+			local cr = fade(circle(bb, c[3] * 0.5, Color3.fromRGB(70, 6, 14), 3), 0.45)
+			cr.Position = UDim2.fromScale(c[1], c[2])
+		end
+		local fall = Vector3.new(0.5, 0.78, 0.37).Unit
+		rig.dist = 560
+		rig.dirFn = function()
+			local d
+			pcall(function()
+				local m = Lighting:GetMoonDirection()
+				if m.Y > 0.25 then
+					d = m
+				end
+			end)
+			return d or fall
+		end
+	end
+	part.Parent = decorHolder()
+	return rig
+end
