+-- v2.52: which yard does a quest-giver / upgrade-sign prompt belong to? (they are baked into
+-- Map.GardenIslands.GardenIsland<n>; older worlds had them inside Plots.Plot<n>) and is that yard MINE?
+local PromptOwn: any = {}
+function PromptOwn.plotOf(d: Instance): Instance?
+	local lr = workspace:FindFirstChild("LeafRush")
+	local plots = lr and lr:FindFirstChild("Plots")
+	if not plots then
+		return nil
+	end
+	local cur: Instance? = d
+	while cur and cur.Parent do
+		local idx = string.match(cur.Name, "^GardenIsland(%d+)$")
+		if idx and cur.Parent.Name == "GardenIslands" then
+			return plots:FindFirstChild("Plot" .. idx)
+		end
+		if cur.Parent == plots then
+			return cur
+		end
+		cur = cur.Parent
+	end
+	return nil
+end
+-- any prompt / click area that sits inside a QuestNpc or UpgradeSign model, or is named like one
+function PromptOwn.isHelper(d: Instance): boolean
+	if d.Name == "QuestNpc" or d.Name == "GardenUpgrade" then
+		return true
+	end
+	local cur = d.Parent
+	while cur and cur ~= workspace do
+		if cur.Name == "QuestNpc" or cur.Name == "UpgradeSign" then
+			return true
+		end
+		cur = cur.Parent
+	end
+	return false
+end
+function PromptOwn.isMine(d: Instance): boolean
+	local plot = PromptOwn.plotOf(d)
+	return plot ~= nil and plot:GetAttribute("OwnerUserId") == player.UserId
+end
