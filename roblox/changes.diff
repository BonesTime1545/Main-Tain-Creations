+---------------------------------------------------------------- v2.51 grass on the tops of Earth blocks
+--[[
+	Every Earth block (and Earth slab) whose top is open grows grass on it too, at its height.
+	Saved in data.Grass.Tops["cx,cz,level"] = growth 0…100 (like the lawn's Cells; reset with
+	them when the yard grows). Published as the plot attribute "GrassTop": "cx,cz,y2,q;…"
+	(y2 = the top's height in half studs, q = growth in 5s) — GrassFX draws it.
+	GRASS SALT (ToolConfig.Consumables): data.Plot.Bare["cx,cz"] = one char per slot, "1" = no
+	grass there ever again; slot 1 = the lawn cell on the floor, slot level - MinLevel + 2 = the
+	top of the block of that level. Published (what is still valid) as the plot attribute
+	"GrassBare": "cx,cz,y2;…" — GrassFX lights those up while the Salt is in the hand.
+	Tools cut tops through the same Cut (CellsIn also returns the keys "cx,cz,level").
+]]
+local function topsOf(data, plot)
+	cells(data, plot) -- (a changed size resets everything)
+	local g = data.Grass
+	if type(g.Tops) ~= "table" then
+		g.Tops = {}
+	end
+	return g.Tops
+end
+
+local function isTopKey(k)
+	return type(k) == "string" and string.match(k, "^%d+,%d+,%-?%d+$") ~= nil
+end
+
+local function slotOf(level) -- nil = the floor
+	if level == nil then
+		return 1
+	end
+	return level - ctx.BlockConfig.MinLevel + 2
+end
