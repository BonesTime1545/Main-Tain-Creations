+-- (the lawn rules, for the tops) one growth step
+function GrassService.GrowTops(data, plot, r, g, isl, more)
+	local spots = GrassService.TopSpots(data, plot)
+	local tops = topsOf(data, plot)
+	local valid, list = {}, {}
+	for _, t in spots do
+		valid[t.Key] = t
+		if not t.Bare then
+			table.insert(list, t)
+		else
+			tops[t.Key] = nil
+		end
+	end
+	for k in tops do
+		if not valid[k] then
+			tops[k] = nil
+		end
+	end
+	if #list == 0 then
+		return 0
+	end
+	local above, grown = 0, {}
+	for _, t in list do
+		local v = tops[t.Key] or 0
+		if v >= g.Tall then
+			above += 1
+		end
+		if v > 0 then
+			table.insert(grown, t)
+		end
+	end
+	local maxAbove = math.max(1, math.floor(#list * (isl.Max or g.MaxShare)))
+	local changed = 0
+	local function grow(t, amount)
+		local v = tops[t.Key] or 0
+		if v >= 100 then
+			return
+		end
+		local nv = math.min(100, v + amount)
+		if v < g.Tall and nv >= g.Tall then
+			if above >= maxAbove then
+				nv = g.Tall - 1
+			else
+				above += 1
+			end
+		end
+		nv = math.floor(nv + 0.5)
+		if nv ~= v then
+			tops[t.Key] = nv
+			changed += 1
+		end
+	end
+	for _, t in grown do
+		if r:NextNumber() < 0.7 then
+			grow(t, r:NextInteger(g.Growth[1], g.Growth[2]) * more)
+		end
+	end
+	-- v2.52: thick grass SPREADS on the tops too (island 4 and later), like on the lawn
+	if (isl.Infect or 0) > 0 then
+		local seeded = 0
+		for _, t in grown do
+			if seeded < 4 and (tops[t.Key] or 0) >= g.Thick and r:NextNumber() < isl.Infect then
+				local d = neighboursOf(t.Cx, t.Cz)[r:NextInteger(1, 4)]
+				local pick = valid[d[1] .. "," .. d[2] .. "," .. t.Level]
+				if pick and not pick.Bare and (tops[pick.Key] or 0) == 0 then
+					grow(pick, r:NextInteger(g.NewGrowth[1], g.NewGrowth[2]))
+					seeded += 1
+				end
+			end
+		end
+	end
+	-- new spots: next to grass on the same level most of the time (the lawn's count)
+	local new = math.clamp(1 + math.floor(#list / 60), g.NewPatches[1], g.NewPatches[2])
+	if GrassService.WeatherMult() > 1.4 then
+		new += 1
+	end
+	for _ = 1, new do
+		local pick
+		if #grown > 0 and r:NextNumber() < g.Spread then
+			local base = grown[r:NextInteger(1, #grown)]
+			local d = neighboursOf(base.Cx, base.Cz)[r:NextInteger(1, 4)]
+			pick = valid[d[1] .. "," .. d[2] .. "," .. base.Level]
+		else
+			pick = list[r:NextInteger(1, #list)]
+		end
+		if pick and not pick.Bare and (tops[pick.Key] or 0) == 0 then
+			grow(pick, r:NextInteger(g.NewGrowth[1], g.NewGrowth[2]))
+		end
+	end
+	return changed
+end
