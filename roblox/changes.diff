+function Features.GateTabs(buttons, map, current, choose)
+	local function refresh()
+		local first
+		for id, b in buttons do
+			local f = map[id]
+			local vis = f == nil or Features.State(f) ~= "locked"
+			b.Visible = vis
+			if vis and (not first or (b.LayoutOrder or 0) < (buttons[first].LayoutOrder or 0)) then
+				first = id
+			end
+		end
+		local cur = current()
+		if cur and buttons[cur] and not buttons[cur].Visible and first and choose then
+			choose(first)
+		end
+	end
+	for _, a in { "IslandTier", "Features" } do
+		player:GetAttributeChangedSignal(a):Connect(refresh)
+	end
+	refresh()
+	return refresh
+end
