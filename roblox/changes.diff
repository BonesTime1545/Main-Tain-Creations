+				local cap = if ctx.ResourceService.Cap then ctx.ResourceService.Cap(plot) else ctx.Config.Plot.MaxResources
+				local room = cap - ctx.ResourceService.Count(plot)
+				local was = fullState[owner] == true
+				local isFull = was
+				if room < 1 then
+					isFull = true
+				elseif room >= math.max(3, math.floor(cap * 0.04)) then
+					isFull = false
+				end
+				if isFull ~= was or owner:GetAttribute("GardenFull") == nil then
+					fullState[owner] = isFull
+					owner:SetAttribute("GardenFull", isFull)
+				end
+			end
+		end
+	end
+	for owner in fullState do
