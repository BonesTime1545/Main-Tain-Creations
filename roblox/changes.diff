+
+-- distance from (x, z) to a zone's box and the unit vector away from it
+local function zoneAway(zn, x, z)
+	local dx = math.abs(x - zn.x) - zn.hx
+	local dz = math.abs(z - zn.z) - zn.hz
+	local d = v2len(math.max(dx, 0), math.max(dz, 0))
+	local ax, az = x - zn.x, z - zn.z
+	if d > 0 then
+		-- (away from the nearest point of the box)
+		local nx = math.clamp(x, zn.x - zn.hx, zn.x + zn.hx)
+		local nz = math.clamp(z, zn.z - zn.hz, zn.z + zn.hz)
+		ax, az = x - nx, z - nz
+	end
+	local m = v2len(ax, az)
+	if m < 1e-3 then
+		return 0, 1, 0
+	end
+	return d, ax / m, az / m
+end
+
+local function legPose(r, part, bc, hy, leg, t, run, swim)
+	local g = r.grow
+	for i, l in r.legs do
+		local front = if i <= 2 then 1 else -1
+		local right = if i % 2 == 1 then 1 else -1
+		local sw = math.sin(t * (if swim then 16 else 11) + (if (i == 1 or i == 4) then 0 else math.pi)) * (0.75 * run)
+		local len = math.max(leg * g + 0.12, 0.2)
+		l.Size = Vector3.new(0.2 + part.Size.X * 0.06, len, 0.2 + part.Size.X * 0.06)
+		l.CFrame = bc * CFrame.new(right * part.Size.X * 0.26, -hy + 0.12, front * part.Size.Z * 0.26) * CFrame.Angles(sw, 0, 0) * CFrame.new(0, -len / 2, 0)
+		l.Transparency = if part.Transparency >= 0.95 then 1 else 0
+	end
+end
+
+function Flutter:_rabid(dt)
+	-- which of my items are rabid (a scan twice a second)
+	local folder = self.folder
+	if not folder or not folder.Parent then
+		return
+	end
+	self.rabScanT += dt
+	if self.rabScanT >= 0.5 then
+		self.rabScanT = 0
+		for _, p in folder:GetChildren() do
+			if p:IsA("BasePart") and p:GetAttribute("Rabid") and not self.rabs[p] then
+				self.rabs[p] = newRunner(self, p)
+			end
+		end
+		for p in self.rabs do
+			if not p.Parent or not p:GetAttribute("Rabid") then
+				self:_rabKill(p)
+			end
+		end
+	end
+	if next(self.rabs) == nil then
+		return
+	end
+	dt = math.min(dt, 0.1)
+	local model = folder.Parent
+	local floor = model and model:FindFirstChild("Floor")
+	if not floor or not floor:IsA("BasePart") then
+		return
+	end
+	local cf = floor.CFrame * CFrame.new(0, floor.Size.Y / 2, 0)
+	local half = floor.Size.X / 2 - 2.5
+	local zones = self:_rabZonesRefresh(cf)
+	local now = os.clock()
+	local st = workspace:GetServerTimeNow()
+	local g = workspace.Gravity
+	-- everybody's place first (the others' headings steer me)
+	local active = {}
+	for part, r in self.rabs do
+		if part.Parent and not part.Anchored and part.ReceiveAge == 0 and not part:GetAttribute("Carried") then
+			r.lp = cf:PointToObjectSpace(part.Position)
+			table.insert(active, part)
+		end
+	end
+	for _, part in active do
+		local r = self.rabs[part]
+		local lp = r.lp
+		local stunned = (part:GetAttribute("StunnedUntil") or 0) > st
+		local want = if stunned then 0 else 1
+		r.grow = math.clamp(r.grow + (want - r.grow) * math.min(1, dt * 4) + (if want > r.grow then dt * 1.4 else -dt * 2.5), 0, 1)
+		if r.grow < 0.02 and stunned then
+			if r.legs then
