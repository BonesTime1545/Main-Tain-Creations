+	Returns touched, rects = { { x0, x1, z0, z1 } }.  touched = false: the polygon does not reach the box. ]]
+function BlockMath.RingRects(hx, hz, poly, step, outward)
+	local n = #poly
+	local pzmin, pzmax = math.huge, -math.huge
+	for _, q in poly do
