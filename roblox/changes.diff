+		local groundY = if down then down.Position.Y else pos.Y - hy - legNow
+		local surf = surfaceAt(pos)
+		local swim = surf ~= nil and surf > groundY + 0.5
+		local base = if swim then surf :: number else groundY
+		local airborne = now < r.jumpUntil
+
+		-- ---------------------------------------------------------------- heading
+		local h = r.h
+		-- danger: the nearest zone
+		local awayX, awayZ, dNear = 0, 0, 1e9
+		local steer = Vector3.zero
+		for _, zn in zones do
+			local d, ax, az = zoneAway(zn, lp.X, lp.Z)
+			if d < dNear then
+				dNear, awayX, awayZ = d, ax, az
+			end
+			if d < FLEE_R then
+				local k = (1 - d / FLEE_R)
+				steer += Vector3.new(ax, 0, az) * (k * 3.4) + Vector3.new(-az * r.side, 0, ax * r.side) * (k * 1.3)
+			end
+		end
+		-- the garden's rim: turn back in
+		local edge = 6
+		if math.abs(lp.X) > half - edge then
+			steer += Vector3.new(-math.sign(lp.X), 0, 0) * ((math.abs(lp.X) - (half - edge)) / edge * 2.2)
+		end
+		if math.abs(lp.Z) > half - edge then
+			steer += Vector3.new(0, 0, -math.sign(lp.Z)) * ((math.abs(lp.Z) - (half - edge)) / edge * 2.2)
+		end
+		-- the other rabid items: keep apart and don't run the same way
+		for _, o in active do
+			if o ~= part then
+				local ro = self.rabs[o]
+				local dx, dz = lp.X - ro.lp.X, lp.Z - ro.lp.Z
+				local d = v2len(dx, dz)
+				if d < OTHER_R then
+					local k = 1 - d / OTHER_R
