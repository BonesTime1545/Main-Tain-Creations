+	local entry = T[petId]
+	if not (a and entry) then
+		return ""
+	end
+	local lv: number = math.clamp(math.floor(tonumber(level) or 1), 1, P.MaxLevel)
+	local variantId = variant or "Normal"
+	local boostN = if type(boost) == "number" and boost > 0 then boost else nil
