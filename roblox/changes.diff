+				end
+			end
+			r.ang = bestA :: number
+		end
+		r.ang += (r.rng:NextNumber() - 0.5) * dt * 1.4 -- (a restless drift)
+		local want3 = Vector3.new(math.cos(r.ang), 0, math.sin(r.ang)) + steer
+		if want3.Magnitude < 0.05 then
