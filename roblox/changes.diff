+	local u = type(O) == "table" and type(O.Boosts) == "table" and tonumber(O.Boosts[key]) or 0
+	if u ~= u or u <= (tonumber(now) or 0) then
+		return 0
+	end
+	return u
+end
+function R.BoostUntil(O, key, now)
+	return activeUntil(O, key, now)
+end
+
+-- the multiplier on everything earned: the permanent ×2 (once) times the best running timed Money boost
+function R.MoneyMult(O, now)
+	if type(O) ~= "table" then
+		return 1
+	end
+	local m = if O.Double == true then 2 else 1
+	local best = 1
+	for _, key in R.OfferBoostKeys do
+		local b = R.OfferBoosts[key]
+		if b.Kind == "Money" and activeUntil(O, key, now) > 0 then
+			best = math.max(best, b.Mult)
+		end
+	end
+	return m * best
+end
+
+-- ×2 XP while the XP boost runs
+function R.XPMult(O, now)
+	local m = 1
+	for _, key in R.OfferBoostKeys do
+		local b = R.OfferBoosts[key]
+		if b.Kind == "XP" and activeUntil(O, key, now) > 0 then
+			m = math.max(m, b.Mult)
+		end
+	end
+	return m
+end
+
+-- { PetLuck, EggFind, MutChance } added to the worn-gear bonuses while the Luck boost runs (zeros otherwise)
+function R.LuckBonus(O, now)
+	local t = { PetLuck = 0, EggFind = 0, MutChance = 0 }
+	for _, key in R.OfferBoostKeys do
+		local b = R.OfferBoosts[key]
+		if b.Kind == "Luck" and activeUntil(O, key, now) > 0 then
+			t.PetLuck += b.PetLuck
+			t.EggFind += b.EggFind
+			t.MutChance += b.MutChance
+		end
+	end
+	return t
+end
+
+-- add `seconds` to a boost (a running one is extended); returns the new end time
+function R.AddBoost(O, key, seconds, now)
+	if type(O) ~= "table" or not boostDef(key) or type(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 then
+		return nil
+	end
+	O.Boosts = if type(O.Boosts) == "table" then O.Boosts else {}
+	local from = math.max(now, activeUntil(O, key, now))
+	local untilT = math.min(from + seconds, now + R.OfferBoostMaxSeconds)
+	O.Boosts[key] = untilT
+	return untilT
+end
+
+-- "1 hour" / "3 hours" / "30 min"
+function R.DurationText(seconds)
+	seconds = math.floor(tonumber(seconds) or 0)
+	if seconds >= 3600 and seconds % 3600 == 0 then
+		local h = seconds // 3600
+		return if h == 1 then "1 hour" else string.format("%d hours", h)
+	end
+	return string.format("%d min", math.max(1, math.floor(seconds / 60 + 0.5)))
+end
+
+local function commas(n)
+	local s = tostring(math.floor(n))
+	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
+	return (out:gsub("^,", ""))
+end
+R.Commas = commas
+
+-- what a card lists: { { Icon, Text, Kind } … } (Text is a plain English line; ru.lua has the templates)
+function R.ContentsList(def)
+	local C = def and def.Contents or {}
+	local out = {}
+	if def and def.Kind == "Double" then
+		table.insert(out, { Icon = "💰", Text = "×2 on ALL Money you earn", Kind = "Double" })
+	end
+	if C.Gems then
+		table.insert(out, { Icon = "💎", Text = string.format("%s Gems", commas(C.Gems)), Kind = "Gems" })
+	end
+	if C.Money then
+		table.insert(out, { Icon = "💰", Text = "💰" .. commas(C.Money), Kind = "Money" })
+	end
+	for _, e in C.Eggs or {} do
+		table.insert(out, { Icon = "🥚", Text = string.format("%s ×%d", R.OfferEggNames[e[1]] or e[1], e[2]), Kind = "Egg" })
+	end
+	for _, id in C.Tools or {} do
+		table.insert(out, { Icon = R.OfferToolIcons[id] or "🧰", Text = R.OfferToolNames[id] or id, Kind = "Tool" })
+	end
+	for _, e in C.Items or {} do
+		table.insert(out, { Icon = R.OfferItemIcons[e[1]] or "🎒", Text = string.format("%s ×%d", R.OfferItemNames[e[1]] or e[1], e[2]), Kind = "Item" })
+	end
+	for _, e in C.Boosts or {} do
+		local b = R.OfferBoosts[e[1]]
+		if b then
+			table.insert(out, { Icon = b.Icon, Text = string.format("%s for %s", b.Name, R.DurationText(e[2])), Kind = "Boost" })
+		end
+	end
+	if C.Height then
+		table.insert(out, { Icon = "🏗", Text = string.format("+%d Build Height steps", C.Height), Kind = "Height" })
+	end
+	if C.Supporter then
+		table.insert(out, { Icon = if C.Supporter >= 2 then "🌟" else "⭐", Text = if C.Supporter >= 2 then "Big Supporter badge" else "Supporter badge", Kind = "Badge" })
+	end
+	return out
+end
+
+-- plain numbers for tests / the UI: { Gems, Money, Eggs, Tools, Items, BoostSeconds, Height }
+function R.ContentsTotals(def)
+	local C = def and def.Contents or {}
+	local t = { Gems = C.Gems or 0, Money = C.Money or 0, Eggs = 0, Tools = #(C.Tools or {}), Items = 0, BoostSeconds = 0, Height = C.Height or 0 }
+	for _, e in C.Eggs or {} do
+		t.Eggs += e[2]
+	end
+	for _, e in C.Items or {} do
+		t.Items += e[2]
+	end
+	for _, e in C.Boosts or {} do
+		t.BoostSeconds += e[2]
+	end
+	return t
+end
+
 return R
