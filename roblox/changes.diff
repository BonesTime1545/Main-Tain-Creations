+		-- yard's footprint, from the bed to just under the lawn. The island ring around the yard stops OUTSIDE the footprint
+		-- (RingRects outward), so no rock / other-coloured island part shows in the pit and nothing is see-through.
+		local t = 3
+		local y0, y1 = bottom, -0.2
+		for _, w in {
+			{ Vector3.new(t, y1 - y0, size + 2 * t), Vector3.new(half + t / 2, (y0 + y1) / 2, 0) },
+			{ Vector3.new(t, y1 - y0, size + 2 * t), Vector3.new(-half - t / 2, (y0 + y1) / 2, 0) },
+			{ Vector3.new(size, y1 - y0, t), Vector3.new(0, (y0 + y1) / 2, half + t / 2) },
