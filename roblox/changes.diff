+	local function boostOf(e) -- toy buff: amount, seconds left
+		local b = json("PetBoost")[tostring(e.Slot)]
+		if type(b) == "table" and type(b.U) == "number" and type(b.B) == "number" and (b.Id == nil or e.Uid == nil or b.Id == e.Uid) then
+			local left = b.U - workspace:GetServerTimeNow()
+			if left > 0 then
+				return b.B, left
+			end
+		end
+		return 0, 0
+	end
+
+	-- the cooldown like the bar under the name: state, seconds left, fill
+	local function cdOf(e)
+		local a = e.Def.Ability
+		if not (a and a.Every ~= nil) then
+			return "passive", 0, 0
+		end
+		local c = json("PetCD")[tostring(e.Slot)]
+		if type(c) ~= "table" then
+			return "wait", 0, 0
+		end
+		if c.R == true then
+			return "ready", 0, 1
+		end
+		if type(c.N) == "number" and type(c.E) == "number" and c.E > 0 then
+			local left = c.N - workspace:GetServerTimeNow()
+			if left <= 0 then
+				return "ready", 0, 1
+			end
+			return "cd", left, math.clamp(1 - left / c.E, 0, 1)
+		end
+		return "wait", 0, 0
+	end
+
