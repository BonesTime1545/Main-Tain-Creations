+}
+
+-- one colour -> its variant colour (greys / whites only lean a little toward the variant's swatch)
+function DecorTypes.TintColor(c, tint)
+	local h, s, v = c:ToHSV()
+	if s < 0.15 and tint.Shift ~= 0 then
+		return c:Lerp(tint.Swatch, 0.3)
+	end
+	return Color3.fromHSV((h + tint.Shift) % 1, math.clamp(s * tint.Sat, 0, 1), math.clamp(v * tint.Val, 0, 1))
+end
+
 return DecorTypes
