+		-- ---------------------------------------------------------------- obstacles: hop onto a step
+		local vy = vel.Y
+		local cleared = true
+		if r.grow >= 0.99 then
+			if not airborne then
+				local reach = size.X / 2 + 2.6
+				local hit = workspace:Raycast(Vector3.new(pos.X, base + 0.5, pos.Z), wdir * reach, self.rayParams)
+				if hit and math.abs(hit.Normal.Y) < 0.6 then
+					local ox = hit.Position + wdir * 0.9
+					local top = workspace:Raycast(Vector3.new(ox.X, base + JUMP_MAX + 2.5, ox.Z), Vector3.new(0, -(JUMP_MAX + 2.5 + 4), 0), self.rayParams)
+					local rise = if top then top.Position.Y - base else 99
+					if rise > JUMP_MAX then
+						-- too tall: another way
+						r.ang += r.side * r.rng:NextNumber(1.3, 2.4)
+						r.reT = now + r.rng:NextNumber(0.9, 1.8)
+						r.side = -r.side
+					elseif rise > 0.4 then
+						local lift = math.max(rise - legNow + hy * 0.3 + 1.1, 1.8)
+						vy = math.sqrt(2 * g * lift)
+						r.jumpUntil = now + 0.3
+						r.jumpTop = (top :: any).Position.Y
+						airborne = true
+					end
+				elseif now > r.hopT then
+					-- a lively little hop now and then
+					r.hopT = now + r.rng:NextNumber(1.5, 4.5)
+					if not swim and (pos.Y - hy - groundY) < legNow + 0.6 then
+						vy = math.sqrt(2 * g * r.rng:NextNumber(1.2, 2.4))
+						r.jumpUntil = now + 0.25
+						airborne = true
+					end
+				end
+			end
+			if r.jumpTop and now < r.jumpUntil + 0.5 and pos.Y - hy < r.jumpTop - 0.1 and vy > -1 then
+				cleared = false -- (still rising along the wall: push on only after the top)
+			else
+				r.jumpTop = nil
+			end
+		end
+
+		-- ---------------------------------------------------------------- vertical: legs hold it up, water holds it afloat
