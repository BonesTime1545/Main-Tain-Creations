+local function solidAtY(blocks, pit, cx, cz, y)
+	local H = BC.Height
+	local level = math.floor(y / H) + 1
+	if level <= 0 and not pit then
+		return false
+	end
+	if level < BC.MinLevel then
+		return true
+	end
+	if level > BC.MaxLevels then
+		return false
+	end
