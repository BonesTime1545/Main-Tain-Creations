+--[[
+	v3 REVEAL. A ScrollingFrame sometimes leaves a card that is only half inside the view
+	undrawn (text only, no paper / buttons) until something scrolls it. reveal() nudges the
+	canvas by one pixel and back, which makes the engine re-clip and draw every child, and
+	makes sure nothing keeps a half-faded value. Safe to call any time; it does nothing
+	while the list is hidden or while the player is dragging it.
+]]
+local lastScroll = setmetatable({}, { __mode = "k" })
+function UIKit.reveal(list)
+	if not list or not list.Parent or not list:IsA("ScrollingFrame") then
+		return
+	end
+	if os.clock() - (lastScroll[list] or 0) < 0.2 then
+		return -- (it is moving: the engine draws it anyway)
+	end
+	local p = list.CanvasPosition
+	local room = list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y
+	if room <= 2 or list.AbsoluteSize.Y <= 0 then
+		return
+	end
+	local nudged = Vector2.new(p.X, if p.Y + 1 <= room then p.Y + 1 else p.Y - 1)
+	list:SetAttribute("Nudging", true)
+	list.CanvasPosition = nudged
+	task.defer(function()
+		if list.Parent and list.CanvasPosition == nudged then
+			list.CanvasPosition = p
+		end
+		list:SetAttribute("Nudging", nil)
+	end)
+end
+
+-- reveal after the layout settled: now, shortly after, and at 0.35 s (debounced per list)
+local settleGen = setmetatable({}, { __mode = "k" })
+function UIKit.settle(list)
+	if not list then
+		return
+	end
+	local gen = (settleGen[list] or 0) + 1
+	settleGen[list] = gen
+	for _, t in { 0.06, 0.35 } do
+		task.delay(t, function()
+			if settleGen[list] == gen or t < 0.1 then
+				if list.Parent then
+					UIKit.reveal(list)
+				end
+			end
+		end)
+	end
+end
+
+function UIKit.watchList(list)
+	if not list or list:GetAttribute("RevealWatched") then
+		return
+	end
+	list:SetAttribute("RevealWatched", true)
+	list:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
+		if not list:GetAttribute("Nudging") then
+			lastScroll[list] = os.clock()
+		end
+	end)
+	list:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
+		UIKit.settle(list)
+	end)
+	list.ChildAdded:Connect(function()
+		UIKit.settle(list)
+	end)
 end
 
