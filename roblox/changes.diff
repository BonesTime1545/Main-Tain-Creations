+local function newScene(index, folder, tierIndex, sites)
+	local E: any = {}
+	E.rng = Random.new(index * 7919 + tierIndex * 104729)
+	E.c = ctx.Config.IslandCenter(index)
+	E.rot = ctx.Config.IslandRotation(index)
+	E.used = {}
+	E.lights = 0
+	local rng = E.rng
+	E.shuffled = table.clone(sites)
+	for k = #E.shuffled, 2, -1 do
+		local j = rng:NextInteger(1, k)
+		E.shuffled[k], E.shuffled[j] = E.shuffled[j], E.shuffled[k]
+	end
+
+	function E.r(a, b)
+		return rng:NextNumber(a, b)
+	end
+	local decorPal = IC().PaletteOf(tierIndex)
+	function E.add(name, size, cf, color, opt)
+		opt = opt or {}
+		local rule = if decorPal then DECOR_RULES[name] else nil
+		if rule then
+			color = tone(color, decorPal[rule[1]], rule[2]) -- (v2.9: benches, logs, trunks, reeds … wear the look's wood / leaf)
+		end
+		local p = Instance.new("Part")
+		p.Name = name
+		p.Anchored = true
+		p.CanCollide = false
+		p.CanQuery = false
+		p.CanTouch = false
+		p.CastShadow = false
+		p.TopSurface = Enum.SurfaceType.Smooth
+		p.BottomSurface = Enum.SurfaceType.Smooth
+		p.Size = size
+		p.CFrame = cf
+		p.Color = color
+		local mat = opt.Material or Enum.Material.Plastic
+		p.Material = mat
+		if opt.Shape then
+			p.Shape = opt.Shape
+		end
+		if opt.Transparency then
+			p.Transparency = opt.Transparency
+		end
+		if mat == Enum.Material.Plastic then
+			p.TopSurface, p.BottomSurface, p.FrontSurface, p.BackSurface, p.LeftSurface, p.RightSurface = STUDS, STUDS, STUDS, STUDS, STUDS, STUDS
+		end
+		p.Parent = folder
+		return p
+	end
+	function E.light(part, color, range, brightness)
+		if E.lights >= 7 then
+			return
+		end
+		E.lights += 1
+		local l = Instance.new("PointLight")
+		l.Color = color
+		l.Range = range
+		l.Brightness = brightness
+		l.Shadows = false
+		l.Parent = part
+	end
+	-- a random free site: pred(site) -> bool, gap = the room it needs round it
+	function E.pick(pred, gap)
+		local list = E.shuffled
+		for k = 1, #list do
+			local s = list[k]
+			if not pred or pred(s) then
+				local ok = true
+				for _, u in E.used do
+					local d = u.P - s.P
+					if d.X * d.X + d.Z * d.Z < ((gap + u.Gap) / 2) ^ 2 then
+						ok = false
+						break
+					end
+				end
+				if ok then
+					table.insert(E.used, { P = s.P, Gap = gap })
+					return s
+				end
+			end
+		end
+		return nil
+	end
+	-- the common kinds of place
+	function E.inner(s)
+		return s.E >= 12
+	end
+	function E.rim(s)
+		return s.E == 8
+	end
+	function E.edge(s)
+		return s.E == 4
+	end
+	function E.solid(s)
+		return s.E >= 8
+	end
+	-- a place with room for something wide (radius up to ~5): well away from the yard's fence
+	function E.deep(s)
+		return s.E >= 8 and math.max(math.abs(s.Lx), math.abs(s.Lz)) >= 60
+	end
+	function E.corner(s)
+		return math.abs(s.Lx) >= 56 and math.abs(s.Lz) >= 56 and s.E >= 8
+	end
+	-- n scenes: pick a place and call fn(site, yaw)
+	function E.scatter(n, pred, gap, fn)
+		for _ = 1, n do
