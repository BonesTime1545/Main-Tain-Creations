+--[[
+	P.Text(petId, variant, level, boost, lang) -> the sentence that says what THIS pet gives RIGHT NOW:
+	its form (Normal / Golden / Diamond / Rainbow), its level (1..10) and — when `boost` is given — the
+	pet toy on it. Every number comes from P.AbilityValue (the same function the game logic uses:
+	PetPowers / PetAbilityService read them through it) and is capped exactly like the logic caps it
+	(`cap` below = the min(...) in PetPowers / PetAbilityService; mutation chances: PetPowers MUT_CAP 0.9).
+	There are NO ability names in these texts. lang = "en" / "ru" (default: P.Lang(), which the client
+	sets to Loc.Language; the server uses English). Pets of an unknown kind give "".
+	Templates: {Key:kind} = the live ability number (kinds: p percent · d time · x multiplier ·
+	m money · i whole number · n:noun number + word), {name} = a number worked out in `calc`,
+	{@Mutation} = "GOLDEN ×25" / «Золотой» ×25 (P.TextMutations has the multipliers).
+]]
+P.Lang = function()
+	return "en"
+end
+
+-- id = { multiplier, English name, Russian name } (the multipliers are MutationConfig's; the test checks them)
+local MUTW = {
+	Golden = { 25, "GOLDEN", "Золотой" }, Rabid = { 25, "RABID", "Бешеный" }, Frozen = { 30, "FROZEN", "Ледяной" }, Frost = { 15, "FROST", "Мороз" },
+	Burning = { 20, "BURNING", "Горящий" }, Molten = { 75, "MOLTEN", "Расплавленный" }, Sunkissed = { 5, "SUNKISSED", "Солнечный" }, Wet = { 2, "WET", "Мокрый" },
+	Soaked = { 6, "SOAKED", "Промокший" }, Windstruck = { 7, "WINDSTRUCK", "Ветреный" }, Stormcharged = { 75, "STORMCHARGED", "Грозовой" }, Bloom = { 8, "BLOOM", "Цветущий" },
+	Verdant = { 9, "VERDANT", "Зеленеющий" }, Lucky = { 77, "LUCKY", "Удачливый" }, Toxic = { 35, "TOXIC", "Токсичный" }, Glitched = { 325, "GLITCH", "Глюк" },
+	Moonlit = { 10, "MOONLIT", "Лунный" }, Bloodlit = { 10, "BLOODLIT", "Кровавый" }, Nebula = { 13, "NEBULA", "Туманность" }, Star = { 90, "STAR", "Звёздный" },
+	Celestial = { 100, "CELESTIAL", "Небесный" }, Cosmic = { 250, "COSMIC", "Космический" }, Void = { 150, "VOID", "Пустота" }, Honey = { 12, "HONEY", "Медовый" },
+	Electric = { 50, "ELECTRIC", "Электрический" }, Aurora = { 40, "AURORA", "Сияние" },
+	Disco = { 125, "DISCO", "Диско" }, Neon = { 250, "NEON", "Неоновый" }, Royal = { 150, "ROYAL", "Королевский" }, Majestic = { 400, "MAJESTIC", "Величественный" },
+}
+P.TextMutations = MUTW
+
+local NOUNS = {
+	item = { { "item", "items" }, { "предмет", "предмета", "предметов" } },
+	stream = { { "stream", "streams" }, { "поток", "потока", "потоков" } },
+	bolt = { { "lightning bolt", "lightning bolts" }, { "молнию", "молнии", "молний" } },
+	best = { { "most valuable item", "most valuable items" }, { "самым ценным предметом", "самыми ценными предметами" } },
+	bestA = { { "most valuable item", "most valuable items" }, { "самый ценный предмет", "самых ценных предмета", "самых ценных предметов" } },
+}
+
+local function trimZeros(s)
+	return (string.gsub(string.gsub(s, "(%..-)0+$", "%1"), "%.$", ""))
+end
+local function fmtPct(x)
+	return trimZeros(string.format("%.1f", math.floor(x * 1000 + 0.5) / 10)) .. "%"
+end
+local function fmtDur(x, ru)
+	local sec, min = if ru then "с" else "s", if ru then "мин" else "min"
+	if x < 60 then
+		return trimZeros(string.format("%.1f", x)) .. " " .. sec
+	end
+	local total = math.floor(x + 0.5)
+	local m, s = total // 60, total % 60
+	if s == 0 then
+		return m .. " " .. min
+	end
+	return m .. " " .. min .. " " .. s .. " " .. sec
+end
+local function fmtMoney(x, ru)
+	local s = tostring(math.floor(x + 0.5))
+	local out = ""
+	while #s > 3 do
+		out = (if ru then "\u{A0}" else ",") .. string.sub(s, -3) .. out
+		s = string.sub(s, 1, #s - 3)
+	end
+	return "💰" .. s .. out
+end
+local function fmtNoun(n, forms, ru)
+	local f = forms[if ru then 2 else 1]
+	local pick
+	if ru and #f == 3 then
+		local m10, m100 = n % 10, n % 100
+		pick = if m10 == 1 and m100 ~= 11 then 1 elseif m10 >= 2 and m10 <= 4 and (m100 < 12 or m100 > 14) then 2 else 3
+	elseif ru then
+		pick = if n % 10 == 1 and n % 100 ~= 11 then 1 else 2
+	else
+		pick = if n == 1 then 1 else 2
+	end
+	return n .. " " .. f[pick]
+end
+
+local function render(tpl, V, calc, ru)
+	return (string.gsub(tpl, "{([^{}]+)}", function(spec)
+		if string.sub(spec, 1, 1) == "@" then
+			local m = MUTW[string.sub(spec, 2)]
+			if not m then
+				return "?"
+			end
+			return (if ru then "«" .. m[3] .. "»" else m[2]) .. " ×" .. m[1]
+		end
+		local key, kind, arg = string.match(spec, "^([%w_]+):?(%a*):?(.*)$")
+		local v = if calc and calc[key] ~= nil then calc[key] else V(key)
+		if type(v) ~= "number" or v ~= v then
+			return "?"
+		end
+		if kind == "p" then
+			return fmtPct(v)
+		elseif kind == "d" then
+			return fmtDur(v, ru)
+		elseif kind == "x" then
+			return "×" .. trimZeros(string.format("%.2f", v))
+		elseif kind == "m" then
+			return fmtMoney(v, ru)
+		elseif kind == "i" then
+			return tostring(math.floor(v + 0.5))
+		elseif kind == "n" then
+			local forms = NOUNS[arg]
+			return if forms then fmtNoun(math.floor(v + 0.5), forms, ru) else "?"
+		end
+		return trimZeros(string.format("%.1f", v))
+	end))
+end
+
+local function fallEN(mut, key)
+	return "Every item that falls gets an extra {" .. (key or "Chance") .. ":p} chance to become {@" .. mut .. "}"
+end
+local function fallRU(mut, key)
+	return "Каждый упавший предмет получает мутацию {@" .. mut .. "} с дополнительным шансом {" .. (key or "Chance") .. ":p}"
+end
