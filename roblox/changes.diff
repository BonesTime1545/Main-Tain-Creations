+---------------------------------------------------------------- "garden is full" pill (top-right corner)
+-- v2.48: small (170 x 30), blinking and shaking a little. v2.49: top-right, in the row of the 👁 HIDE button,
+-- just LEFT of it (also on phones, where the touch button column hangs under that button).
+function GameFX:_gardenFull()
+	local Prefs = require(script.Parent:WaitForChild("Prefs"))
+	local RunService = game:GetService("RunService")
+	local GuiService = game:GetService("GuiService")
+	local player = self.player
+	local gui = Instance.new("ScreenGui")
+	gui.Name = "LeafRushGardenFull"
+	gui.ResetOnSpawn = false
+	gui.DisplayOrder = 44
+	gui.IgnoreGuiInset = true
+	pcall(function()
+		gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets -- (notches / rounded corners of phones)
+	end)
+	gui.Parent = player:WaitForChild("PlayerGui")
+	local pill = Instance.new("Frame")
+	pill.Name = "GardenFull"
+	pill.AnchorPoint = Vector2.new(1, 0)
+	pill.Position = UDim2.new(1, -12, 0, 8)
+	pill.Size = UDim2.fromOffset(170, 30)
+	pill.BackgroundColor3 = Color3.fromRGB(235, 130, 40)
+	pill.BackgroundTransparency = 1
+	pill.Visible = false
+	pill.Parent = gui
+	local scale = Instance.new("UIScale")
+	scale.Parent = pill
+	local corner = Instance.new("UICorner")
+	corner.CornerRadius = UDim.new(0.5, 0)
+	corner.Parent = pill
+	local stroke = Instance.new("UIStroke")
+	stroke.Color = Color3.fromRGB(120, 55, 10)
+	stroke.Thickness = 2
+	stroke.Transparency = 1
+	stroke.Parent = pill
+	local label = Instance.new("TextLabel")
+	label.BackgroundTransparency = 1
+	label.Size = UDim2.new(1, -12, 1, 0)
+	label.Position = UDim2.fromOffset(6, 0)
+	label.Font = Enum.Font.FredokaOne
+	label.TextScaled = true
+	label.Text = "🍂 GARDEN FULL!"
+	label.TextColor3 = Color3.new(1, 1, 1)
+	label.TextStrokeTransparency = 0.4
+	label.TextStrokeColor3 = Color3.fromRGB(120, 55, 10)
+	label.TextTransparency = 1
+	label.Parent = pill
+	local lim = Instance.new("UITextSizeConstraint")
+	lim.MaxTextSize = 18
+	lim.MinTextSize = 8
+	lim.Parent = label
+	local ORANGE, RED = Color3.fromRGB(235, 130, 40), Color3.fromRGB(225, 60, 45)
+	local shown, vis, conn = false, 0, nil
+	-- v2.49: the pill sits in the same row as the 👁 HIDE button (top-right corner), right next to it on its LEFT
+	local hideBtn
+	local function anchor(): (number, number)
+		local pg = player:FindFirstChild("PlayerGui")
+		if not hideBtn or not hideBtn.Parent then
+			local g = pg and pg:FindFirstChild("LeafRushHideToggle")
+			hideBtn = g and g:FindFirstChild("Toggle")
+		end
+		if hideBtn and hideBtn:IsA("GuiObject") and hideBtn.AbsoluteSize.X > 0 then
+			local p, sz = hideBtn.AbsolutePosition, hideBtn.AbsoluteSize
+			return p.X - 8, p.Y + math.max(0, (sz.Y - pill.AbsoluteSize.Y) / 2)
+		end
+		local cam = workspace.CurrentCamera
+		return (if cam then cam.ViewportSize.X else 1280) - 12, 8
+	end
+	local function step(dt)
+		vis = math.clamp(vis + (if shown then dt else -dt) / 0.3, 0, 1)
+		local t = os.clock()
+		local pulse = 0.5 + 0.5 * math.sin(t * 8) -- blinking
+		local cam = workspace.CurrentCamera
+		local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
+		scale.Scale = math.clamp(math.min(vp.X / 720, vp.Y / 420), 0.75, 1)
+		pill.BackgroundColor3 = ORANGE:Lerp(RED, pulse)
+		pill.BackgroundTransparency = 1 - vis * (0.6 + 0.4 * pulse)
+		stroke.Transparency = 1 - vis
+		label.TextTransparency = 1 - vis * (0.7 + 0.3 * pulse)
+		-- a slight shake: a few pixels
+		local ox, oy = math.sin(t * 43) * 2.2, math.sin(t * 57 + 1) * 1.6
+		local ax, ay = anchor()
+		pill.Position = UDim2.fromOffset(ax + ox, ay + oy)
+		if vis <= 0 and not shown then
+			pill.Visible = false
+			if conn then
+				conn:Disconnect()
+				conn = nil
+			end
+		end
+	end
+	local function refresh()
+		local want = player:GetAttribute("GardenFull") == true and Prefs.On("GardenFullAlert")
+		if want == shown then
+			return
+		end
+		shown = want
+		if want then
+			pill.Visible = true
+			if not conn then
+				conn = RunService.RenderStepped:Connect(step)
+			end
+		end
+	end
+	player:GetAttributeChangedSignal("GardenFull"):Connect(refresh)
+	player:GetAttributeChangedSignal("Setting_GardenFullAlert"):Connect(refresh)
+	refresh()
+end
