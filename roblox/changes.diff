+-- the attributes the clients read: grown tops, and the spots without grass (Grass Salt)
+function GrassService.PublishTops(data, plot)
+	local tops = topsOf(data, plot)
+	local valid, parts, bare = {}, {}, {}
+	for _, t in GrassService.TopSpots(data, plot) do
+		valid[t.Key] = true
+		local y2 = math.floor(t.Y * 2 + 0.5)
+		if t.Bare then
+			tops[t.Key] = nil
+			if #bare < 600 then
+				table.insert(bare, t.Cx .. "," .. t.Cz .. "," .. y2)
+			end
+		else
+			local q = math.clamp(math.floor((tops[t.Key] or 0) / 5 + 0.5), 0, 20)
+			if q > 0 and #parts < 600 then
+				table.insert(parts, t.Cx .. "," .. t.Cz .. "," .. y2 .. "," .. q)
+			end
+		end
+	end
+	for k in tops do
+		if not valid[k] then
+			tops[k] = nil
+		end
+	end
+	local blocks = data.Plot.Blocks
+	local n = GrassService.GridN(plot)
+	if type(data.Plot.Bare) == "table" then
+		for k, v in data.Plot.Bare do
+			local sx, sz = string.match(k, "^(%d+),(%d+)$")
+			if type(v) == "string" and string.sub(v, 1, 1) == "1" and sx and tonumber(sx) < n and tonumber(sz) < n and not (type(blocks) == "table" and (blocks[k] ~= nil or (type(blocks.Pit) == "table" and blocks.Pit[k] ~= nil))) and #bare < 600 then
+				table.insert(bare, k .. ",0")
+			end
+		end
+	end
+	plot.Model:SetAttribute("GrassTop", table.concat(parts, ";"))
+	plot.Model:SetAttribute("GrassBare", table.concat(bare, ";"))
+end
