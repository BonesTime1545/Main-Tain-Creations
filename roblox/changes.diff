+		local okScale = pcall(function()
+			cos:ScaleTo(k)
+		end)
+		local height = size.Y * (if okScale then k else 1)
+		local t0 = os.clock()
+		local function pose()
+			local t = os.clock() - t0
+			local rise = math.min(1, t / 0.7)
+			local e = 1 - (1 - rise) ^ 3
+			local bob = math.sin(t * 2.2) * 0.18
+			pcall(cos.PivotTo, cos, c.base * CFrame.new(0, hover * e - 1.5 * (1 - e) + bob, 0) * CFrame.Angles(0, t * 0.9, 0))
