+				p.AssemblyAngularVelocity = Vector3.zero
+				p.CFrame = CFrame.new(cf:PointToWorldSpace(Vector3.new(x, math.max(p.Size.Y, p.Size.X) / 2 + 0.6, z)))
+			end
+		end
+	end
+end
