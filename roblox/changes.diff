+-- v2.44: extras standing on the fence POSTS (towers of the castle, lollipops of the candy fence, gem tops …)
+local function fencePostTops(plot, style, color, post, put2)
+	if not plot.Deco then
+		return
+	end
+	for _, d in plot.Deco:GetChildren() do
+		if d.Name == "Post" and d:IsA("BasePart") then
+			local top = d.Position + Vector3.new(0, d.Size.Y / 2, 0)
+			if style == "Castle" then
+				put2(top + Vector3.new(0, 1.3, 0), Vector3.new(1.5, 2.6, 1.5), color, nil)
+				put2(top + Vector3.new(0, 2.8, 0), Vector3.new(1.9, 0.4, 1.9), post:Lerp(Color3.new(1, 1, 1), 0.3), nil)
+				put2(top + Vector3.new(0, 3.8, 0), Vector3.new(0.12, 1.8, 0.12), Color3.fromRGB(80, 80, 90), nil)
+				put2(top + Vector3.new(0.4, 4.3, 0), Vector3.new(0.8, 0.5, 0.1), post, nil)
+			elseif style == "Candy" or style == "Picket" or style == "Planks" or style == "Rainbow" then
+				put2(top + Vector3.new(0, 0.45, 0), Vector3.new(0.8, 0.8, 0.8), if style == "Rainbow" then RAINBOW[(math.floor(top.X + top.Z) % 6) + 1] else post, "Ball")
+			elseif style == "Gems" or style == "Crystals" then
+				put2(top + Vector3.new(0, 0.6, 0), Vector3.new(0.7, 0.7, 0.7), post, "Gem")
+			elseif style == "Spears" or style == "Lantern" then
+				put2(top + Vector3.new(0, 0.5, 0), Vector3.new(0.6, 0.6, 0.6), post, "Ball")
+			end
+		end
+	end
+end
