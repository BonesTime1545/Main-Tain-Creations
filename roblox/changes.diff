+-- the tool ids in your hotbar (the layout you made, or the default one)
+local function hotbarToolIds(TC)
+	local ids = {}
+	if player:GetAttribute("HotbarSet") == true then
+		for _, e in decode(player:GetAttribute("Hotbar")) do
+			if type(e) == "table" and e.K == "Tool" and type(e.Id) == "string" then
+				ids[e.Id] = true
+			end
+		end
+	else
+		local t = decode(player:GetAttribute("Tools"))
+		ids[t.Grass or TC.StarterGrassTool] = true
+		for _, id in t.Owned or {} do
+			ids[id] = true -- (the default hotbar holds every helper you own)
+		end
+	end
+	return ids
+end
+
+function ToyPicker.OpenTools(deps, kitId, onPick)
+	ToyPicker.Close()
+	local K, TC, TM = deps.UIKit, deps.ToolConfig, deps.ToolModels
+	local kit = TC and TC.Consumables[kitId]
+	if not K or not kit or not TM then
+		return false
+	end
+	local tools = decode(player:GetAttribute("Tools"))
+	local owned = {}
+	for _, id in tools.Owned or {} do
+		owned[id] = true
+	end
+	local inBar = hotbarToolIds(TC)
+	local list = {}
+	for _, id in { "Shears", "WeedCutter", "Scythe", "Pickaxe" } do
+		if TC.RepairTargets[id] and owned[id] and inBar[id] then
+			local left, max
+			if id == "Pickaxe" then
+				max = tonumber(player:GetAttribute("PickCap"))
+				local used = tonumber(player:GetAttribute("PickUsed"))
+				left = if max and used then max - used else nil
+			else
+				left, max = tonumber(player:GetAttribute("ML_" .. id)), tonumber(player:GetAttribute("MM_" .. id))
+			end
+			local up = (tools.Up or {})[id]
+			local stats = TC.GrassStats(id, up)
+			local name = if stats then stats.Display elseif id == "Pickaxe" then TC.PickaxeTiers[TC.PickaxeTier(up)].Name .. " Pickaxe" else TC.Def(id).Display
+			table.insert(list, { Id = id, Name = name, Left = left or 0, Max = max or 0, Tier = TC.HelperTier(id, up), Levels = up })
+		end
+	end
