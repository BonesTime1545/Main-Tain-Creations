+-- v3.x HINGED PARTS: a part tagged Anim = Flap / FlapSlow / Droop / Lift (wings, shells) or Swing (legs)
+-- carries a "Hinge" attribute (a point in model space, = where its root edge touches the body) and is
+-- rotated AROUND that hinge, so it stays attached to the body. Flap* / Droop / Lift turn about the
+-- front-back axis through the hinge (the wing tip goes up / down), Swing about the left-right axis.
+--   hwing(model, hinge, side, rest, kind, specs)  builds one wing from several parts; hinge.X is mirrored
+--     by `side` (-1 / 1); `rest` = resting roll (rad, positive = tip up, mirrored); each spec is
+--     { name, shape, size, color, offset, rotation, material, transparency } with the offset measured
+--     from the hinge in wing space (x = outward along the wing, y up, z back).
+--   swing(part, hinge, phase) hangs a leg part on a hip hinge.
+local function hwing(m, hinge, sx, rest, kind, specs)
+	local h = Vector3.new(sx * hinge.X, hinge.Y, hinge.Z)
+	local out = {}
+	for _, sp in specs do
+		local o = sp[5]
+		local r = sp[6] or Vector3.zero
+		local rel = CFrame.new(h) * CFrame.Angles(0, 0, sx * rest) * CFrame.new(sx * o.X, o.Y, o.Z) * CFrame.Angles(r.X, sx * r.Y, sx * r.Z)
+		local p = part(m, sp[1], sp[2], sp[3], sp[4], rel, sp[7])
+		if sp[8] then
+			p.Transparency = sp[8]
+		end
+		p:SetAttribute("Anim", kind)
+		p:SetAttribute("Phase", sx)
+		p:SetAttribute("Hinge", h)
+		table.insert(out, p)
+	end
+	return out
+end
+
+local function swing(p, hinge, phase)
+	p:SetAttribute("Anim", "Swing")
+	p:SetAttribute("Phase", phase or 0)
+	p:SetAttribute("Hinge", hinge)
+	return p
+end
+
+local HINGED = { Flap = true, FlapSlow = true, Droop = true, Lift = true, Swing = true }
+local function hingeRel(p, extra, rel)
+	local h = p:GetAttribute("Hinge")
+	if typeof(h) ~= "Vector3" then
+		return rel * extra
+	end
+	local H = CFrame.new(h)
+	return H * extra * H:Inverse() * rel
+end
