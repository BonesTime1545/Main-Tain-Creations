+-- v2.48: "Priciest Item" also counts the items LYING in the garden: the few most valuable
+-- ones (by their raw price, cheap to rank) are valued exactly like the label shows them
+-- and recorded in Stats.BestItem. At most once per 8 s per player (force = on leave).
+local lyingAt = {}
+function LeaderboardService.NoteLying(player, force)
+	local RS, ES, MT = ctx.ResourceService, ctx.EconomyService, ctx.MutationTypes
+	if not (RS and ES and ES.NoteItem and MT and ctx.PlotSystem) then
+		return
+	end
+	local now = os.clock()
+	if not force and now - (lyingAt[player] or -99) < 8 then
+		return
+	end
+	lyingAt[player] = now
+	local plot = ctx.PlotSystem.Get(player)
+	if not plot then
+		return
+	end
+	local MAS = ctx.MutationAbilityService
+	local top = {} -- the 4 most valuable by raw value: { raw, type, mutation, amount, extra, vm }
+	for part in RS.AliveIn(plot) do
+		local i = RS.RawInfo(part)
+		local def = i and ctx.ResourceTypes[i.Type]
+		if def and part.Parent and (def.Value or 0) > 0 then
+			local vm = tonumber(part:GetAttribute("ValMult")) or 1
+			local extra = nil
+			if MAS and i.Mutation then
+				local ok, e = pcall(MAS.SaleExtra or MAS.ValueExtra, part, i)
+				if ok then
+					extra = e
+				end
+			end
+			local raw = MT.ItemValue(def.Value, i.Amount or 1, i.Mutation, extra, vm)
+			if #top < 4 or raw > top[#top][1] then
+				table.insert(top, { raw, i.Type, i.Mutation, i.Amount or 1, extra, vm })
+				table.sort(top, function(a, b)
+					return a[1] > b[1]
+				end)
+				if #top > 4 then
+					table.remove(top)
+				end
+			end
+		end
+	end
+	for _, t in top do
+		pcall(ES.NoteItem, player, t[2], t[3], t[4], t[5], t[6])
+	end
+end
