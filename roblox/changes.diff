 local fmt = Hud.fmt
 
+-- the SPEED panel text: 1 -> "×1", 1.2 -> "×1.2", 1.346 -> "×1.35" (two decimals at most, trailing zeros trimmed)
+function Hud.fmtSpeed(m)
+	m = tonumber(m) or 1
+	if m ~= m or m < 0 then
+		m = 1
+	end
+	local t = string.format("%.2f", math.floor(m * 100 + 0.5) / 100)
+	t = string.gsub(t, "0+$", "")
+	t = string.gsub(t, "%.$", "")
+	return "×" .. t
+end
+
+-- neutral (white) at ×1 → green → gold as the multiplier grows; orange when slowed (water, thick grass)
+function Hud.speedColor(m)
+	m = tonumber(m) or 1
+	local white, green, gold = Color3.fromRGB(255, 246, 232), Color3.fromRGB(120, 240, 120), Color3.fromRGB(255, 205, 60)
+	if m < 0.995 then
+		return Color3.fromRGB(255, 160, 90)
+	elseif m <= 1.005 then
+		return white
+	end
+	local t = math.clamp((m - 1) / 0.6, 0, 1)
+	if t < 0.5 then
+		return white:Lerp(green, t * 2)
+	end
+	return green:Lerp(gold, (t - 0.5) * 2)
+end
+
