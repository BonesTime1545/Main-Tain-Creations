+local function buildFenceShape(plot, skin)
+	local old = plot.Model:FindFirstChild("FenceShape")
+	if old then
+		old:Destroy()
+	end
+	local style = skin and skin.Style
+	local build = style and FENCE_STYLES[style]
+	if not build then
+		return
+	end
+	local folder = Instance.new("Folder")
+	folder.Name = "FenceShape"
+	local count = 0
+	local function brick(cf, size, color, opts)
+		count += 1
+		if count > 2600 then
+			return
+		end
+		local p = Instance.new("Part")
+		p.Anchored = true
+		p.CanCollide = false
+		p.CanQuery = false
+		p.CanTouch = false
+		p.CastShadow = false
+		p.Material = if opts and opts.Neon then Enum.Material.Neon else Enum.Material.Plastic -- (the same toy-brick plastic for every skin)
+		if opts and opts.Ball then
+			p.Shape = Enum.PartType.Ball
+		elseif opts and opts.Cyl then
+			p.Shape = Enum.PartType.Cylinder
+		end
+		p.Size = size
+		p.Color = color
+		p.CFrame = cf
+		for _, face in { "TopSurface", "BottomSurface", "FrontSurface", "BackSurface", "LeftSurface", "RightSurface" } do
+			(p :: any)[face] = Enum.SurfaceType.Studs
+		end
+		p.Parent = folder
+	end
+	local color, post = skin.Color, skin.Post
+	for _, seg in fenceSegments(plot) do
+		local function put(along, up, size, c, opts)
+			local cf
+			if seg.AlongX then
+				cf = seg.Part.CFrame * CFrame.new(along, seg.Top + up, (opts and opts.Side) or 0)
+			else
+				cf = seg.Part.CFrame * CFrame.new((opts and opts.Side) or 0, seg.Top + up, along) * CFrame.Angles(0, math.pi / 2, 0)
+			end
+			if opts and opts.Cyl and opts.Up then
+				cf *= CFrame.Angles(0, 0, math.pi / 2) -- (a cylinder lies along X: stand it up; without Up it lies along the wall)
+			end
+			if opts and opts.Rot then
+				cf *= opts.Rot
+			end
+			brick(cf, size, c, opts)
+		end
+		build(put, seg, color, post, plot)
+	end
+	fencePostTops(plot, style, color, post, function(pos, size, c, kind)
+		local cf = CFrame.new(pos)
+		if kind == "Gem" then
+			cf *= CFrame.Angles(math.rad(45), math.rad(45), 0)
+		end
+		brick(cf, size, c, if kind == "Ball" then { Ball = true } else nil)
+	end)
+	folder.Parent = plot.Model
+end
