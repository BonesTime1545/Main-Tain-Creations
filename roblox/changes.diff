+		show.hidBuild = bg
+		bg.Enabled = false
+	end
+	if not show.hudOn then
+		show.hudOn = true
+		DecorBoxes.HideHud()
+	end
+end
+local function restoreBuild()
+	restoreHint()
+	if show.hudOn then
+		show.hudOn = false
+		DecorBoxes.RestoreHud()
+	end
+	if show.hidBuild then
+		show.hidBuild.Enabled = true
+		show.hidBuild = nil
+	end
+end
