+			local a, b = poly[i], poly[i % n + 1]
+			local z1, z2 = a[2], b[2]
+			if z1 ~= z2 and ((z1 <= z and z <= z2) or (z2 <= z and z <= z1)) then
+				local x = a[1] + (z - z1) * (b[1] - a[1]) / (z2 - z1)
+				lo, hi = math.min(lo, x), math.max(hi, x)
+			end
+		end
+		return lo, hi
+	end
