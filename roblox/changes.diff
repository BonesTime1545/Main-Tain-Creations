+-- perf: runs `fn` at most ~10 times a second (a leading call, then one trailing call)
+local function coalesced(fn, gap)
+	gap = gap or 0.1
+	local last, pending = -1, false
+	return function()
+		local n = os.clock()
+		if n - last >= gap then
+			last = n
+			fn()
+		elseif not pending then
+			pending = true
+			task.delay(gap - (n - last), function()
+				pending = false
+				last = os.clock()
+				fn()
+			end)
+		end
+	end
+end
