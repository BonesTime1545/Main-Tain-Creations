+-- v2.6x: undo of a block put down in the Editor: the cell must still hold exactly that block;
+-- it goes back to what was there before (nothing, or the single slab). Same rules as breaking.
+function BlockService.UndoPlace(player, op)
+	local data, plot, size = garden(player)
+	if not data then
+		return false, "Your yard isn't ready"
+	end
+	local blocks = data.Plot.Blocks
+	local cx, cz, level = op.Cx, op.Cz, op.Level
+	if BM.Get(blocks, cx, cz, level) ~= op.Code then
+		return false, "That block was changed since"
+	end
+	local cell = cellSize()
+	local ok, why = BM.CheckChange(blocks, data.Plot.Objects, cx, cz, level, nil, size, cell)
+	if not ok then
+		return false, why
+	end
+	if not nestsKeep(data, cx, cz, level, op.Prev, size) then
+		return false, "An egg stands on this block — open it first"
+	end
+	if not boxesKeep(data, cx, cz, level, op.Prev, size) then
+		return false, "A cosmetic box stands on this block — open it first"
+	end
+	BM.Set(blocks, cx, cz, level, op.Prev, op.PrevVar)
+	touch(plot, level)
+	fx("Break", player, plot, cx, cz, level, op.Code, 1, 0)
+	return true
+end
