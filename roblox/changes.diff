+function BlockMath.BedAim(place, o, d)
+	if type(place) ~= "table" or place.Level ~= Cfg.MinLevel or d.Y > -1e-4 then
+		return nil
+	end
+	local lv = place.Level - 1
+	local t = (lv * Cfg.Height - o.Y) / d.Y
+	if t <= 0 then
+		return nil
+	end
+	return lv, o + d * t
