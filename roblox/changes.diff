+---------------------------------------------------------------- v2.80 ⭐ OFFERS · 🎁 BUNDLES · 2× MONEY FOREVER
+--[[
+	Request: { Action = "Buy", Kind = "Offer", Payload = { Id } }  (RobuxConfig.Offers) -> ok, message
+	Each offer is its own Developer Product (RobuxConfig.OfferProducts); the receipt is matched by product id.
+	Saved in data.Offers = { Double, Supporter, Bundles = { [id] = n }, Bought = { [id] = n }, Boosts = { [key] = unixEnd } }.
+	Published for the UI: attributes DoubleMoney (1 / 0), OfferState (JSON), SupporterTier, BoostMoneyMult,
+	BoostMoneyUntil, BoostLuckUntil, BoostXPUntil.
+]]
+local HttpService = game:GetService("HttpService")
+
+local function offersOf(data)
+	if type(data.Offers) ~= "table" then
+		data.Offers = {}
+	end
+	local O = data.Offers
+	O.Bundles = if type(O.Bundles) == "table" then O.Bundles else {}
+	O.Bought = if type(O.Bought) == "table" then O.Bought else {}
+	O.Boosts = if type(O.Boosts) == "table" then O.Boosts else {}
+	O.Supporter = if type(O.Supporter) == "number" then O.Supporter else 0
+	O.Double = O.Double == true
+	return O
+end
+
+function MonetizationService.PublishOffers(player)
+	local data = ctx.PlayerDataService.Get(player)
+	if not data or typeof(player) ~= "Instance" then
+		return
+	end
+	local O, t, RCfg = offersOf(data), MonetizationService.Now(), RC()
+	player:SetAttribute("DoubleMoney", if O.Double then 1 else 0)
+	player:SetAttribute("SupporterTier", O.Supporter)
+	player:SetAttribute("BoostMoneyMult", RCfg.MoneyMult({ Boosts = O.Boosts }, t))
+	local moneyUntil = math.max(RCfg.BoostUntil(O, "Money2", t), RCfg.BoostUntil(O, "Money3", t))
+	player:SetAttribute("BoostMoneyUntil", moneyUntil)
+	player:SetAttribute("BoostLuckUntil", RCfg.BoostUntil(O, "Luck", t))
+	player:SetAttribute("BoostXPUntil", RCfg.BoostUntil(O, "XP", t))
+	pcall(function()
+		player:SetAttribute("OfferState", HttpService:JSONEncode({ Double = O.Double, Bundles = O.Bundles, Supporter = O.Supporter }))
+	end)
+end
+
+function MonetizationService.OnLoaded(player)
+	MonetizationService.PublishOffers(player)
+end
+
+-- grant the Money multiplier / boosts to the rest of the game: EconomyService.ValueOf, LevelService.AddXP and
+-- GearService.Bonus read data.Offers through RobuxConfig.MoneyMult / XPMult / LuckBonus (one place each)
+
+local GRASS_RANK = { Shears = 1, WeedCutter = 2, Scythe = 3, PushMower = 4, Trimmer = 5, RidingMower = 6 }
+
+-- give the contents of an offer; returns the number of parts that worked, and the texts
+local function grantContents(player, data, def, O)
+	local C, texts, okParts = def.Contents or {}, {}, 0
+	local now = MonetizationService.Now()
+	local function part(f)
+		local ok, err = pcall(f)
+		if ok then
+			okParts += 1
+		else
+			warn("[LeafRush] offer " .. def.Id .. " part failed: " .. tostring(err))
+		end
+	end
+	if C.Gems then
+		part(function()
+			ctx.CurrencyService.Grant(player, { Gems = C.Gems }, "robux")
+			table.insert(texts, "💎" .. C.Gems)
+		end)
+	end
+	if C.Money then
+		part(function()
+			ctx.CurrencyService.Grant(player, { LeafValue = C.Money }, "robux") -- (a gift, not an earning: never doubled)
+			table.insert(texts, "💰" .. RC().Commas(C.Money))
+		end)
+	end
+	for _, e in C.Eggs or {} do
+		part(function()
+			assert(ctx.PetConfig.Eggs[e[1]], "unknown egg " .. tostring(e[1]))
+			data.Eggs.Owned[e[1]] = (data.Eggs.Owned[e[1]] or 0) + e[2]
+			table.insert(texts, "🥚×" .. e[2])
+		end)
+	end
+	if C.Eggs and ctx.PetService and ctx.PetService.Publish then
+		pcall(ctx.PetService.Publish, player)
+	end
+	for _, id in C.Tools or {} do
+		part(function()
+			local TC = ctx.ToolConfig
+			local kind = TC.KindOf(id)
+			assert(kind == "Grass" or kind == "Helper", "unknown tool " .. tostring(id))
+			local def2 = TC.Def(id)
+			if data.Tools.Owned[id] then
+				-- (owned already: its Money price instead — nothing is wasted)
+				local back = def2.Price or 0
+				if back > 0 then
+					ctx.CurrencyService.Grant(player, { LeafValue = back }, "robux")
+					table.insert(texts, "💰" .. RC().Commas(back))
+				end
+				return
+			end
+			data.Tools.Owned[id] = true
+			if kind == "Grass" and (GRASS_RANK[id] or 0) > (GRASS_RANK[data.Tools.Grass] or 0) then
+				data.Tools.Grass = id -- (a better grass tool goes into slot 2; never a worse one)
+			end
+			table.insert(texts, def2.Icon or "🧰")
+		end)
+	end
+	if C.Tools and ctx.ToolService then
+		pcall(function()
+			ctx.ToolService.GiveTools(player)
+			ctx.ToolService.Publish(player)
+		end)
+	end
+	for _, e in C.Items or {} do
+		part(function()
+			local given = ctx.ToolService.GiveItem(player, e[1], e[2])
+			assert(given > 0, "item not given")
+			local d = ctx.ToolConfig.Consumables[e[1]]
+			table.insert(texts, (d and d.Icon or "🎒") .. "×" .. given)
+		end)
+	end
+	for _, e in C.Boosts or {} do
+		part(function()
+			assert(RC().AddBoost(O, e[1], e[2], now), "bad boost")
+			local b = RC().OfferBoosts[e[1]]
+			table.insert(texts, b.Icon .. " " .. math.floor(e[2] / 60) .. "m")
+		end)
+	end
+	if C.Height then
+		part(function()
+			local E = ctx.EndgameConfig and ctx.EndgameConfig.BuildHeight
+			assert(E and ctx.UpgradeService, "no build height")
+			data.Rebirth = data.Rebirth or {}
+			data.Rebirth.Upgrades = data.Rebirth.Upgrades or {}
+			local lvl = ctx.UpgradeService.BuildHeightLevel(data)
+			local top = #E.Steps -- (the last step, UNLIMITED, stays a separate Robux purchase)
+			local newLvl = math.min(lvl + C.Height, math.max(top, lvl))
+			if newLvl > lvl then
+				data.Rebirth.Upgrades.BuildHeight = newLvl
+				table.insert(texts, "🏗+" .. (newLvl - lvl))
+			end
+			if newLvl - lvl < C.Height then
+				-- (what did not fit became Gems: 100 per step)
+				local gems = (C.Height - (newLvl - lvl)) * 100
+				ctx.CurrencyService.Grant(player, { Gems = gems }, "robux")
+				table.insert(texts, "💎" .. gems)
+			end
+			ctx.UpgradeService.Publish(player)
+		end)
+	end
+	if C.Supporter then
+		part(function()
+			O.Supporter = math.max(O.Supporter, math.min(C.Supporter, 99))
+			table.insert(texts, if C.Supporter >= 2 then "🌟" else "⭐")
+		end)
+	end
+	return okParts, texts
+end
+
+-- hands over an offer. Returns ok, message. `opts.Free` = Studio simulation.
+function MonetizationService.GrantOffer(player, def)
+	local data = ctx.PlayerDataService.Get(player)
+	if not data or not def then
+		return false, "Try again"
+	end
+	local O = offersOf(data)
+	local RCfg = RC()
+	if RCfg.OfferOwned(O, def) then
+		-- (a receipt for something owned already: Gems instead, never lost)
+		local gems = RCfg.OfferRefundGems(def)
+		ctx.CurrencyService.Grant(player, { Gems = gems }, "robux")
+		MonetizationService.PublishOffers(player)
+		return true, string.format("💎 +%d Gems — you own %s already. Thank you!", gems, def.Display)
+	end
+	local msg
+	if def.Kind == "Double" then
+		O.Double = true
+		msg = "💰 2× MONEY FOREVER is yours — everything you earn is doubled! Thank you!"
+	else
+		local okParts, texts = grantContents(player, data, def, O)
+		if okParts == 0 and next(def.Contents) ~= nil then
+			return false, "Try again"
+		end
+		if def.Once then
+			O.Bundles[def.Id] = 1
+		else
+			O.Bundles[def.Id] = math.min((O.Bundles[def.Id] or 0) + 1, 999)
+		end
+		msg = string.format("🎁 %s: %s — thank you!", def.Display, table.concat(texts, " · "))
+	end
+	O.Bought[def.Id] = math.min((O.Bought[def.Id] or 0) + 1, 9999)
+	MonetizationService.PublishOffers(player)
+	if ctx.Net and ctx.Net.Notify then
+		ctx.Net.Notify:FireClient(player, msg)
+	end
+	return true, msg
+end
+
+-- a client asks to buy an offer (opens the Robux prompt, or simulates it in Studio)
+function MonetizationService.OfferStart(player, id)
+	local data = ctx.PlayerDataService.Get(player)
+	local def = type(id) == "string" and RC().OfferById[id]
+	if not data or not def then
+		return false, "Unknown offer"
+	end
+	if RC().OfferOwned(offersOf(data), def) then
+		return false, "You already own it"
+	end
+	local productId = RC().OfferProductOf(def)
+	if not productId then
+		if MonetizationService.IsStudio() and RC().StudioSimulate then
+			local ok, msg = MonetizationService.GrantOffer(player, def)
+			return ok, if ok then string.format("🛠 Studio: purchase simulated (%d R$) · %s", def.Robux, tostring(msg)) else msg
+		end
+		return false, "Not available yet"
+	end
+	local ok = pcall(MonetizationService.Prompt, player, productId)
+	return ok, if ok then nil else "Try again"
+end
+
+-- request wrapper: Kind "Offer" (Buy)
+local baseHandle = MonetizationService.Handle
+MonetizationService.Handle = function(player, req)
+	if type(req) == "table" and req.Kind == "Offer" and req.Action == "Buy" then
+		if ctx.EconomyService and ctx.EconomyService.Throttle and not ctx.EconomyService.Throttle(player, "offer", 1) then
+			return false, "Slow down"
+		end
+		local id = type(req.Payload) == "table" and req.Payload.Id or nil
+		return MonetizationService.OfferStart(player, id)
+	end
+	return baseHandle(player, req)
+end
+
+-- receipt wrapper: a product that belongs to an offer is handled here (same idempotency + save rules as the
+-- tier products above); every other product goes to the original ProcessReceipt
+local baseProcessReceipt = MonetizationService.ProcessReceipt
+MonetizationService.ProcessReceipt = function(info)
+	local def = RC().OfferOfProduct(info.ProductId)
+	if not def then
+		return baseProcessReceipt(info)
+	end
+	local player = Players:GetPlayerByUserId(info.PlayerId)
+	local data = player and ctx.PlayerDataService.Get(player)
+	if not player or not data then
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	data.Robux = data.Robux or { Receipts = {}, Spent = 0 }
+	if type(data.Robux.Receipts) ~= "table" then
+		data.Robux.Receipts = {}
+	end
+	local key = tostring(info.PurchaseId)
+	if data.Robux.Receipts[key] then
+		local u = unsaved[player]
+		if u and u[key] then
+			if ctx.PlayerDataService.SaveNow and not ctx.PlayerDataService.SaveNow(player) then
+				return Enum.ProductPurchaseDecision.NotProcessedYet
+			end
+			u[key] = nil
+		end
+		return Enum.ProductPurchaseDecision.PurchaseGranted
+	end
+	local spent = tonumber(info.CurrencySpent) or def.Robux
+	data.Robux.Receipts[key] = MonetizationService.Now()
+	data.Robux.Spent = (tonumber(data.Robux.Spent) or 0) + spent
+	unsaved[player] = unsaved[player] or {}
+	unsaved[player][key] = true
+	local okGrant, ok = pcall(MonetizationService.GrantOffer, player, def)
+	if not okGrant or not ok then
+		warn("[LeafRush] offer grant failed, will be retried: " .. tostring(ok))
+		data.Robux.Receipts[key] = nil
+		data.Robux.Spent = math.max(0, (tonumber(data.Robux.Spent) or 0) - spent)
+		unsaved[player][key] = nil
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	if ctx.PlayerDataService.SaveNow and not ctx.PlayerDataService.SaveNow(player) then
+		return Enum.ProductPurchaseDecision.NotProcessedYet
+	end
+	if unsaved[player] then
+		unsaved[player][key] = nil
+	end
+	return Enum.ProductPurchaseDecision.PurchaseGranted
+end
+
+
 return MonetizationService
