+	end
+	function E.rim(s)
+		return s.E == 8
+	end
+	function E.edge(s)
+		return s.E == 4
+	end
+	function E.solid(s)
+		return s.E >= 8
+	end
+	-- a place with room for something wide (radius up to ~5): well away from the yard's fence
+	function E.deep(s)
