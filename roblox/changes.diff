+				want3 = (Vector3.new(awayX, 0, awayZ) * (0.35 + need) + Vector3.new(tx, 0, tz) * 0.9).Unit
+			end
+		end
+		h = (h + (want3 - h) * math.min(1, dt * 5))
+		if h.Magnitude < 0.05 then
+			h = want3
+		end
+		h = h.Unit
+		r.h = h
+		local wdir = cf:VectorToWorldSpace(h)
+		wdir = Vector3.new(wdir.X, 0, wdir.Z).Unit
