+	local c = part.Color
+	if part:GetAttribute("Mutation") ~= nil then
+		local okR, RT = pcall(function()
+			return require(script.Parent:WaitForChild("ResourceTypes", 2) :: any)
+		end)
+		local def = okR and type(RT) == "table" and RT[part:GetAttribute("ResourceType") or part.Name]
+		if type(def) == "table" and type(def.Colors) == "table" and typeof(def.Colors[1]) == "Color3" then
+			c = def.Colors[1]
+		end
