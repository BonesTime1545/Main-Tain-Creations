+-- v2.46 🗑 DELETE MODE: while it is ON a click on a pet tile SELLS one pet of that tile
+-- (never a favourite, a pet that follows you, one on the hotbar or in a trade offer).
+-- It is OFF whenever the Inventory is closed or another tab is opened (InventoryUI).
+function PetsUI:SetDeleteMode(on)
+	self.delMode = on == true
+end
+
+function PetsUI:_deleteTile(key)
+	local info = self.petTiles and self.petTiles[key]
+	if not info then
+		return
+	end
+	local H = self.Hotbar
+	local fav, eq, other = false, false, false
+	local pick = nil
+	for _, m in info.Pets do
+		local hot = false
+		if H then
+			local okH, on = pcall(H.Has, H, "Pet", m.Uid)
+			hot = okH and on == true
+		end
+		local lockedNow = false
+		if type(self.IsOffered) == "function" then
+			local okL, on = pcall(self.IsOffered, m.Uid)
+			lockedNow = okL and on == true
+		end
+		if m.Fav == true then
+			fav = true
+		elseif m.Eq == true then
+			eq = true
+		elseif hot or lockedNow then
+			other = true
+		else
+			pick = pick or m
+		end
+	end
+	if not pick then
+		local why = if fav then "⭐ A favourite can't be sold — take the star off first" elseif eq then "A pet that follows you can't be deleted — unequip it first" else "This pet is on the hotbar or in a trade"
+		self.Hud:Toast(why, 2.4, true)
+		if self.Sfx then
+			self.Sfx.Play("Error")
+		end
+		return
+	end
+	local uid = pick.Uid
+	self:_send({ Action = "Sell", Uid = uid }, function(msg)
+		if self.selUid == uid then
+			self.selUid = nil
+		end
+		self.Hud:Toast(msg, 2)
+		if self.Sfx then
+			self.Sfx.Play("Coin")
+		end
+	end)
+end
+
+-- v2.46: right mouse button on a pet tile = EQUIP / UNEQUIP (the same server actions as the panel's button)
+function PetsUI:_rightClick(key)
+	if self.delMode then
