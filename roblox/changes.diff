+-- v2.45: the Editor's menu is hidden while a show plays, and comes back afterwards
+local function hideHint() -- v2.46: the Editor's control-hint line (Hud status) stays away during a show
+	pcall(function()
+		player:SetAttribute("ShowHidesHint", true)
+		local pg = player:FindFirstChild("PlayerGui")
+		local hg = pg and pg:FindFirstChild("LeafRushHud")
+		local st = hg and hg:FindFirstChild("Status")
+		if st and st:IsA("GuiObject") then
+			st.Visible = false
+		end
+	end)
+end
+local function restoreHint()
+	pcall(function()
+		player:SetAttribute("ShowHidesHint", nil)
+		local pg = player:FindFirstChild("PlayerGui")
+		local hg = pg and pg:FindFirstChild("LeafRushHud")
+		local st = hg and hg:FindFirstChild("Status")
+		if st and st:IsA("TextLabel") and st.Text ~= "" then
+			st.Visible = true
+		end
+	end)
+end
+-- v2.47: while an egg / box opening show plays ALL other GUIs of the PlayerGui are hidden (the show's own
+-- guis and the touch controls stay); they come back exactly as they were. Counted, so nested use is fine.
+local HUD_KEEP = { LeafRushBoxShow = true, LeafRushHatch = true, TouchGui = true }
+local hudHide = { depth = 0, list = {}, conn = nil, t = 0 }
+local function hudSweep()
+	local pg = player:FindFirstChild("PlayerGui")
+	if not pg then
+		return
+	end
+	for _, g in pg:GetChildren() do
+		if g:IsA("ScreenGui") and g.Enabled and not HUD_KEEP[g.Name] then
+			hudHide.list[g] = true
+			g.Enabled = false
+		end
+	end
+end
+function DecorBoxes.HideHud()
+	hudHide.depth += 1
+	if hudHide.depth > 1 then
+		return
+	end
+	pcall(hudSweep)
+	hudHide.conn = RunService.Heartbeat:Connect(function()
+		if os.clock() - hudHide.t >= 0.25 then
+			hudHide.t = os.clock()
+			pcall(hudSweep) -- (something opened / re-enabled meanwhile: it stays hidden)
+		end
+	end)
+end
+function DecorBoxes.RestoreHud()
+	if hudHide.depth <= 0 then
+		return
+	end
+	hudHide.depth -= 1
+	if hudHide.depth > 0 then
+		return
+	end
+	if hudHide.conn then
+		hudHide.conn:Disconnect()
+		hudHide.conn = nil
+	end
+	local list = hudHide.list
+	hudHide.list = {}
+	for g in list do
+		if g.Parent then
+			pcall(function()
+				g.Enabled = true
+			end)
+		end
+	end
+end
+
