+-- v2.50: the weather's own lighting. Bloom and sun rays only with "Show effects" on and not
+-- on Low graphics; the ambient colours / atmosphere / contrast are always on (they cost nothing)
+function WeatherFX:_applyFx(t, vis)
+	vis = vis or self.fxVis
+	if not vis then
+		return
+	end
+	self.fxVis = vis
+	local fx = vis.Fx or {}
+	local B = self.fxBase
+	local rich = Prefs.On("Effects") and Quality.Level() > 1
+	local b = if rich and fx.Bloom then fx.Bloom else B.Bloom
+	local r = if rich and fx.Rays then fx.Rays else B.Rays
+	local info = TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
+	TweenService:Create(self.bloom, info, { Intensity = b[1], Size = b[2], Threshold = b[3] }):Play()
+	TweenService:Create(self.rays, info, { Intensity = r[1], Spread = r[2] }):Play()
+	TweenService:Create(Lighting, info, { OutdoorAmbient = fx.Ambient or B.Ambient, ColorShift_Top = fx.Shift or B.Shift }):Play()
+	TweenService:Create(self.atmo, info, { Decay = fx.Decay or B.Decay, Glare = fx.Glare or B.Glare, Offset = fx.Offset or B.Offset }):Play()
+	TweenService:Create(self.cc, info, { Contrast = fx.Contrast or 0 }):Play()
+end
