+-- v2.51: a layer is rebuilt WITHOUT tearing it down first: the bricks that come out the same
+-- are kept, only new ones are made and only the ones that are gone are destroyed (after
+-- the new ones exist) — placing / breaking one block no longer re-creates the whole floor
+local function rebuildLayer(plot, s, blocks, n, level)
+	pool = {}
+	for _, p in s.Layers[level] or {} do
+		local sig = sigOf[p]
+		if sig and p.Parent then
+			local list = pool[sig]
+			if not list then
+				list = {}
+				pool[sig] = list
+			end
+			table.insert(list, p)
+		else
+			p:Destroy()
+		end
+	end
+	local old = s.Layers[level] or {}
+	local ok, err = pcall(rebuildLayerRaw, plot, s, blocks, n, level)
+	local left = pool
+	pool = nil
+	if not ok then
+		-- (v2.53 dig) a rebuild that throws must NEVER leave the layer without its bricks (before:
+		-- the old ones were destroyed with the pool and the half-made new ones stayed — blocks that
+		-- are gone for everybody, nothing to stand on): the layer stays as it was, the new bricks go
+		local was = {}
+		for _, p in old do
+			was[p] = true
+		end
+		for _, p in s.Layers[level] or {} do
+			if not was[p] then
+				p:Destroy()
+			end
+		end
+		local keep = {}
+		for _, p in old do
+			if p.Parent then
+				table.insert(keep, p)
+			end
+		end
+		s.Layers[level] = keep
+		error(err, 0)
+	end
+	for _, list in left do
+		for _, p in list do
+			p:Destroy()
+		end
+	end
+	if not ok then
+		error(err, 0)
+	end
+end
