+		end
+	end
+	function E.at(p, yaw, off)
+		return CFrame.new(p) * CFrame.Angles(0, yaw or 0, 0) * CFrame.new(off or Vector3.zero)
+	end
+
+	-- ---------- looping ambient particles on four strips AROUND the yard (never over the build area)
+	function E.ring(name, spec)
