+--[[
+	v2.43 THE REPAIR KIT's panel — the same kind of panel as the toys', for TOOLS:
+	one row for every Shears / Weed Cutter / Scythe / Pickaxe that is in your HOTBAR: its 3D
+	model (in its tier's look), its name and how much durability is left. Tap a worn one =
+	repair it (the Kit is used up); one that is as good as new can't be picked. ✕ / the
+	background / Esc = never mind. The server checks everything (ToolService.Use "RepairKit").
+	  ToyPicker.OpenTools(deps, kitId, onPick)   deps = { UIKit, ToolConfig, ToolModels, Hud }
+												 onPick(toolId) is called once
+]]
+-- the tool ids in your hotbar (the layout you made, or the default one)
+local function hotbarToolIds(TC)
+	local ids = {}
+	if player:GetAttribute("HotbarSet") == true then
+		for _, e in decode(player:GetAttribute("Hotbar")) do
+			if type(e) == "table" and e.K == "Tool" and type(e.Id) == "string" then
+				ids[e.Id] = true
+			end
+		end
+	else
+		local t = decode(player:GetAttribute("Tools"))
+		ids[t.Grass or TC.StarterGrassTool] = true
+		for _, id in t.Owned or {} do
+			ids[id] = true -- (the default hotbar holds every helper you own)
+		end
+	end
+	return ids
+end
+
+function ToyPicker.OpenTools(deps, kitId, onPick)
+	ToyPicker.Close()
+	local K, TC, TM = deps.UIKit, deps.ToolConfig, deps.ToolModels
+	local kit = TC and TC.Consumables[kitId]
+	if not K or not kit or not TM then
