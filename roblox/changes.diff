+	-- the bed's underside (BlockConfig.Below slots + the bed) + 6 studs of rock under it, in whole 4-stud layers
+	return math.ceil((Cfg.Below * Cfg.Height + 1 + 6 + BlockMath.IslandWideBottom) / 4) * 4
+end
