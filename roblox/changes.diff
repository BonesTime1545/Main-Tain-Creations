+			p.Size = o.Size
+			p.CFrame = o.CF
+			if p:GetAttribute("LRCarved") then
+				local want = p:GetAttribute("LRWantT")
+				if type(want) == "number" then
+					p.Transparency = want
+				end
+				p:SetAttribute("LRCarved", nil)
+				p:SetAttribute("LRWantT", nil)
+			end
+		end
+	end
+	s.Carved = nil
+	for b in s.Fill or {} do
+		b:Destroy()
+	end
+	s.Fill = nil
+	s.FillSrc = nil
+	s.CarveSize = nil
+	s.CarveKey = nil
+end
