+		local parts, rels, lids = {}, {}, {}
+		local boxH = 2.6
+		if built then
+			boxH = tonumber(built:GetAttribute("Height")) or boxH
+			for _, p in built:GetChildren() do
+				if p:IsA("BasePart") then
+					table.insert(parts, p)
+					table.insert(rels, p.CFrame)
+					lids[p] = p:GetAttribute("Lid") == true
+					p.CFrame = base * p.CFrame
+					p.Parent = model
+				end
+			end
+			built:Destroy()
+		end
+		return parts, rels, lids, boxH
+	end
+	function spec.Pool()
+		local pool = {}
