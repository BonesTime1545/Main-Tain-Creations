+function GrassService.IsBare(data, cx, cz, level)
+	local b = data.Plot.Bare
+	local s = if type(b) == "table" then b[cx .. "," .. cz] else nil
+	if type(s) ~= "string" then
+		return false
+	end
+	local i = slotOf(level)
+	return string.sub(s, i, i) == "1"
+end
+
+local function setBare(data, cx, cz, level)
+	if type(data.Plot.Bare) ~= "table" then
+		data.Plot.Bare = {}
+	end
+	local k = cx .. "," .. cz
+	local s = data.Plot.Bare[k]
+	s = if type(s) == "string" then s else ""
+	local i = slotOf(level)
+	if #s < i then
+		s ..= string.rep("0", i - #s)
+	end
+	data.Plot.Bare[k] = string.sub(s, 1, i - 1) .. "1" .. string.sub(s, i + 1)
+end
