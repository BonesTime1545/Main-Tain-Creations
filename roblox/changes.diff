+-- the Earth tops of a garden that are open: { Cx, Cz, Level, Key, Y (studs above the floor), Bare }
+function GrassService.TopSpots(data, plot)
+	local out = {}
+	local BC = ctx.BlockConfig
+	local blocks = data.Plot.Blocks
+	if not BC or type(blocks) ~= "table" then
+		return out
+	end
+	local n = GrassService.GridN(plot)
+	for k, col in blocks do
+		if type(col) == "string" then
+			local sx, sz = string.match(k, "^(%d+),(%d+)$")
+			local cx, cz = tonumber(sx), tonumber(sz)
+			if cx and cz and cx < n and cz < n then
+				for level = 1, math.min(#col, BC.MaxLevels) do
+					local code = string.sub(col, level, level)
+					if code == "D" or code == "d" then
+						local up = string.sub(col, level + 1, level + 1)
+						if up == "" or (not BC.IsSolid(up) and up ~= "W") then
+							table.insert(out, {
+								Cx = cx,
+								Cz = cz,
+								Level = level,
+								Key = cx .. "," .. cz .. "," .. level,
+								Y = (level - 1) * BC.Height + (if code == "d" then BC.SlabHeight or BC.Height / 2 else BC.Height),
+								Bare = GrassService.IsBare(data, cx, cz, level),
+							})
+						end
+					end
+				end
+			end
+		end
+	end
+	return out
+end
