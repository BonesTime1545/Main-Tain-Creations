+			local hx, hz = s.X / 2 + 0.05, s.Z / 2 + 0.05
+			table.insert(boxes, { p.X, p.Z, rx.X, rx.Z, bx.X, bx.Z, hx, hz, hx * hx + hz * hz })
+		end
+	end
+	local function onGrass(x, z)
+		for _, b in boxes do
+			local dx, dz = x - b[1], z - b[2]
+			if dx * dx + dz * dz <= b[9] then
+				local u, v = dx * b[3] + dz * b[4], dx * b[5] + dz * b[6]
+				if u >= -b[7] and u <= b[7] and v >= -b[8] and v <= b[8] then
+					return true
+				end
+			end
+		end
+		return false
+	end
+	local c = ctx.Config.IslandCenter(index)
+	local rot = ctx.Config.IslandRotation(index)
+	local cs, sn = math.cos(rot), math.sin(rot)
+	local sites = {}
+	-- v2.62 (straight): the body of a diagonal island is turned by `ang` (WorldBuilder.straightenIslands): the 4-stud lattice
+	-- of sites and the four "outward" directions follow its own axes (ang = 0 on the islands left as baked)
+	local ang = if ctx.Config.IslandBodyRotation then ctx.Config.IslandBodyRotation(index) else 0
+	local bc, bs = math.cos(ang), math.sin(ang)
+	local ax, az = Vector3.new(bc, 0, -bs), Vector3.new(bs, 0, bc)
+	local axes = { ax, -ax, az, -az }
+	for i = -18, 17 do
+		for j = -18, 17 do
+			local gx, gz = i * 4 + 2, j * 4 + 2
+			local dx, dz = gx * bc + gz * bs, -gx * bs + gz * bc
+			local x, z = c.X + dx, c.Z + dz
+			if onGrass(x, z) then
+				local lx, lz = dx * cs - dz * sn, dx * sn + dz * cs
+				if math.max(math.abs(lx), math.abs(lz)) >= 55 and not (lz > 36 and math.abs(lx) < 14) then
