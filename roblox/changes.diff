+end
+
+-- the Collect zones of my yard in the floor's local space { x, z, hx, hz }
+function Flutter:_rabZonesRefresh(cf)
+	local now = os.clock()
+	if now - self.rabZonesT < 1 then
+		return self.rabZones
+	end
+	self.rabZonesT = now
+	local out = {}
+	for _, m in (self.objects and self.objects:GetChildren()) or {} do
+		if m:GetAttribute("Type") == "CollectionZone" then
