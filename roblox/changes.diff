+---------------------------------------------------------------- v2.50 first person (V)
+-- V (the "Camera" key of Settings · CONTROLS, rebindable) switches Setting_CameraMode between
+-- "Aim" and "FirstPerson" for every tool. The pickaxe has a controller of its own, so it
+-- applies that mode itself: first person while the pickaxe is in the hand (and no window is
+-- open — a window needs the mouse), the normal camera again when it is put away.
+local fpOn = false
+local prevCam, prevMin
+
+applyCamera = function()
+	local char = player.Character
+	local hum = char and char:FindFirstChildOfClass("Humanoid")
+	local want = tool ~= nil and tool.Parent == char and hum ~= nil and hum.Health > 0 and player:GetAttribute("Setting_CameraMode") == "FirstPerson" and not (deps and deps.IsUiOpen and deps.IsUiOpen())
+	if want and not fpOn then
+		fpOn = true
+		prevCam, prevMin = player.CameraMode, player.CameraMinZoomDistance
+		player.CameraMode = Enum.CameraMode.LockFirstPerson
+	elseif not want and fpOn then
+		fpOn = false
+		-- (another LeafTool taking over keeps the first person with its own controller)
+		local other
+		for _, c in if char then char:GetChildren() else {} do
+			if c:IsA("Tool") and c ~= tool and c:GetAttribute("LeafTool") ~= nil and c:GetAttribute("LeafTool") ~= "Pickaxe" then
+				other = c
+			end
+		end
+		if other then
+			return
+		end
+		player.CameraMode = if prevCam and prevCam ~= Enum.CameraMode.LockFirstPerson then prevCam else Enum.CameraMode.Classic
+		if player.CameraMode == Enum.CameraMode.Classic then
+			-- step back out to a comfortable third-person distance
+			local old = prevMin or 0.5
+			player.CameraMinZoomDistance = math.min(12, player.CameraMaxZoomDistance)
+			task.delay(0.15, function()
+				if not fpOn then
+					player.CameraMinZoomDistance = old
+				end
+			end)
+		end
+	end
+end
