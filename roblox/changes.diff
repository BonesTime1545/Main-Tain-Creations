+---------------------------------------------------------------- v2.46 RABID runners (my own items)
+--[[
+	A rabid item grows four legs, then RUNS: its own random heading (per item), never toward
+	a Collect zone (it turns away from the zone and may circle round it), away from the other
+	rabid items' headings; it HOPS onto steps up to one block high (real jumps), skips over
+	other items (its collision group) and paddles fast through water. Only parts this client
+	simulates (ReceiveAge == 0 in my yard).
+]]
+function Flutter:_rabKill(part)
+	local r = self.rabs[part]
+	if r and r.legs then
+		for _, l in r.legs do
+			l:Destroy()
+		end
+	end
+	self.rabs[part] = nil
+end
+
+local function newRunner(self, part)
+	seedN += 1
+	local rng = Random.new(os.clock() * 1000 + seedN * 7919)
+	return {
+		rng = rng,
+		ang = rng:NextNumber(0, math.pi * 2),
+		h = Vector3.new(1, 0, 0),
+		reT = 0,
+		side = if rng:NextNumber() < 0.5 then -1 else 1,
+		grow = 0,
+		phase = rng:NextNumber(0, 6.28),
+		jumpUntil = 0,
+		hopT = os.clock() + rng:NextNumber(1.2, 4),
+		speedK = rng:NextNumber(0.9, 1.15),
+		stuck = 0,
+		yaw = nil,
+		lp = Vector3.zero,
+	}
+end
+
+local function makeLegs(self, part, r)
+	local folder = workspace:FindFirstChild("LeafRushRabidLegs")
+	if not folder then
+		folder = Instance.new("Folder")
+		folder.Name = "LeafRushRabidLegs"
+		folder.Parent = workspace
+	end
+	-- v2.47: the legs are a darker shade of the ITEM's own main colour (its colour on the lawn is
