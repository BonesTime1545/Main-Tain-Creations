+---------------------------------------------------------------- v2.50 passive mutation chances
+-- (the pets with Ability.Mut / Ability.Muts: PetConfig "PASSIVE MUTATION CHANCES"). Always on, whatever
+-- the weather; nothing is sent to the clients (the pet panels show the numbers from the description)
+local MUT_CAP = 0.9 -- (the extra chance of ONE mutation never passes this, with any pets / levels)
+
+-- { [mutation id | "Random" | "Copy"] = extra chance } or nil when no equipped pet has one
+function PetPowers.MutBonuses(player)
+	if not player then
+		return nil
+	end
+	local out
+	for _, e in equipped(player) do
+		local a = e.Def.Ability
+		if a.Mut or a.Muts then
+			local c = AV(e, a.MutKey or "Chance")
+			if type(c) == "number" and c > 0 then
+				out = out or {}
+				if a.Muts then
+					for id, ratio in a.Muts do
+						out[id] = math.min((out[id] or 0) + c * ratio, MUT_CAP)
+					end
+				else
+					out[a.Mut] = math.min((out[a.Mut] or 0) + c, MUT_CAP)
+				end
+			end
+		end
+	end
+	return out
+end
+
+-- a mutation some other item of this garden already carries (not a base one)
+local function copyMutation(plot)
+	local RS, MS = ctx.ResourceService, ctx.MutationTypes
+	local ids = {}
+	for part in RS.AliveIn(plot) do
+		local _, key = RS.Info(part)
+		if key then
+			for _, id in MS.List(key) do
+				local d = MS.Config.Defs[id]
+				if d and not d.Base then
+					table.insert(ids, id)
+				end
+			end
+		end
+	end
+	if #ids == 0 then
+		return nil
+	end
+	return ids[rng:NextInteger(1, #ids)]
+end
+
+-- one roll of every passive mutation chance for an item (its mutation key, may be nil):
+-- the ids that landed. scale = 1 for a freshly dropped item, less for the idle roll
+function PetPowers.MutRoll(player, plot, key, scale)
+	local bonus = PetPowers.MutBonuses(player)
+	if not bonus then
+		return nil
+	end
+	local MS = ctx.MutationTypes
+	local defs = MS.Config.Defs
+	local out
+	for id, c in bonus do
+		if rng:NextNumber() < c * (scale or 1) then
+			local real = id
+			if id == "Random" then
+				real = randomMutation()
+			elseif id == "Copy" then
+				real = copyMutation(plot)
+			end
+			local d = real and defs[real]
+			if d and not has(key, real) and not (d.Base and key ~= nil and MS.BaseOf(key) ~= nil) then
+				out = out or {}
+				table.insert(out, real)
+			end
+		end
+	end
+	return out
+end
