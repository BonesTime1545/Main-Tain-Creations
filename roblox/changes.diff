+-- v2.52 THE QUEST GIVER and the UPGRADE sign work only in YOUR OWN garden.
+-- (Why it failed before: both are baked into the ISLAND (Map.GardenIslands.GardenIsland<n>), not into the
+-- Plots folder this code and PlotSystem.setHelpers looked at, so their prompts stayed ON for everybody.)
+-- Now: PlotSystem switches them off on the server for good; this client looks at EVERY prompt of those two
+-- models (islands and plots) and enables only the ones of the yard it owns; PromptTriggered ignores the rest.
+do
+	local prompts: { Instance } = {}
+	local function track(d: Instance)
+		if (d:IsA("ProximityPrompt") or d:IsA("ClickDetector")) and PromptOwn.isHelper(d) then
+			if d:IsA("ProximityPrompt") then
+				d.Enabled = false -- (off at once, the loop below switches the own ones on)
+			else
+				d.MaxActivationDistance = 0
+			end
+			table.insert(prompts, d)
+		end
+	end
+	local function refresh()
+		for i = #prompts, 1, -1 do
+			local pr = prompts[i]
+			if not pr.Parent then
+				table.remove(prompts, i)
+			else
+				local mine = PromptOwn.isMine(pr)
+				if pr:IsA("ProximityPrompt") then
+					if pr.Enabled ~= mine then
+						pr.Enabled = mine
+					end
+				else
+					(pr :: any).MaxActivationDistance = if mine then 32 else 0
+				end
+			end
+		end
+	end
+	task.spawn(function()
+		local lr = workspace:WaitForChild("LeafRush", 30)
+		if not lr then
+			return
+		end
+		local plotsFolder = lr:WaitForChild("Plots", 30)
+		local map = lr:WaitForChild("Map", 30)
+		local gardens = map and map:WaitForChild("GardenIslands", 30)
+		for _, folder in { plotsFolder, gardens } do
+			if folder then
+				for _, d in folder:GetDescendants() do
+					track(d)
+				end
+				folder.DescendantAdded:Connect(function(d)
+					track(d)
+					task.defer(refresh)
+				end)
+			end
+		end
+		if plotsFolder then
+			for _, plot in plotsFolder:GetChildren() do
+				plot:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
+			end
+		end
+		refresh()
+		while true do
+			refresh()
+			task.wait(1)
+		end
+	end)
+end
+-- v2.51 the island scenery's looping particles (IslandService.ApplyDecor): "Show effects" off = none,
+-- "Low graphics" / Low quality = a third of them
+do
+	local PrefsM = require(script:WaitForChild("Prefs"))
+	local emitters: { ParticleEmitter } = {}
+	local function mult(): number
+		if not PrefsM.On("Effects") then
+			return 0
+		end
+		if PrefsM.Get("LowGraphics") == true or Quality.Level() <= 1 then
+			return 0.35
+		end
+		return 1
+	end
+	local function apply(em: ParticleEmitter)
+		local m = mult()
+		em.Rate = (em:GetAttribute("BaseRate") or 0) * m
+		em.Enabled = m > 0
+	end
+	local function applyAll()
+		for i = #emitters, 1, -1 do
+			if emitters[i].Parent then
+				apply(emitters[i])
+			else
+				table.remove(emitters, i)
+			end
+		end
+	end
+	local function track(d: Instance)
+		if d:IsA("ParticleEmitter") and d:GetAttribute("IslandFX") then
+			table.insert(emitters, d)
+			apply(d)
+		end
+	end
+	PrefsM.Changed("Effects", applyAll)
+	PrefsM.Changed("LowGraphics", applyAll)
+	task.spawn(function()
+		local lr = workspace:WaitForChild("LeafRush", 30)
+		local map = lr and lr:WaitForChild("Map", 30)
+		local gardens = map and map:WaitForChild("GardenIslands", 30)
+		if not gardens then
+			return
+		end
+		for _, d in gardens:GetDescendants() do
+			track(d)
+		end
+		gardens.DescendantAdded:Connect(track)
+	end)
+end
