+-- Editor UNDO of "place an egg": the egg goes back to the inventory (nothing is paid when
+-- an egg is placed, so nothing is refunded; the nest is gone, the timer starts again on the
+-- next placement). Not possible once the egg was opened.
+function IncubatorService.Unplace(player, nestId, eggId, first)
+	local data = ctx.PlayerDataService.Get(player)
+	if not data or type(nestId) ~= "string" then
+		return false, "Not now"
+	end
+	local list = nests(data)
+	local nest = list[nestId]
+	if type(nest) ~= "table" or nest.Egg ~= eggId or not P().Eggs[eggId] then
+		return false, "This egg was already opened"
+	end
+	if IncubatorService.IsOpening(player) then
+		return false, "Finish the opening you started first"
+	end
+	list[nestId] = nil
+	IncubatorService.Despawn(player, nestId)
+	data.Eggs.Owned[eggId] = (data.Eggs.Owned[eggId] or 0) + 1
+	if first == true then
+		data.Eggs.FirstNest = false -- (the quick first egg is given back too)
+	end
+	ctx.PetService.Publish(player)
+	IncubatorService.Publish(player)
+	return true
+end
