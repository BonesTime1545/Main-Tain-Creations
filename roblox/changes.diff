+function W.Decide(pity, dry, x, y, got)
+	if (dry or 0) + 1 >= W.JackpotPity then
+		return W.JackpotIndex(), "JackpotPity"
+	end
+	if (pity or 0) + 1 >= W.Pity then
+		return W.PickExclusive(y, got), "Pity"
