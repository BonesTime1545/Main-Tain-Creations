+-- ================================================================ 🎁 GIVE ITEMS (admin cheats tab)
+-- { Action = "GiveCatalog" } -> the list of everything an admin can give themselves
+-- { Action = "GiveThing", Cat, Id, Amount, Variant?, Level? } -> gives it to the ADMIN'S OWN data.
+-- Handle() checked IsAdmin before this is reached. Every grant uses the game's own data
+-- shapes / services (BuildService.Grant, ToolService.GiveItem, PetService.Add …) so the
+-- save stays valid and the client sees the new thing at once (Publish calls).
+local giveCatalogCache
+
+local MONEY_STEPS = {
+	{ "M10K", "LeafValue", 10000, "💰 Money +10,000" },
+	{ "M1M", "LeafValue", 1000000, "💰 Money +1,000,000" },
+	{ "M1B", "LeafValue", 1000000000, "💰 Money +1,000,000,000" },
+	{ "G100", "Gems", 100, "💎 Gems +100" },
+	{ "G10K", "Gems", 10000, "💎 Gems +10,000" },
+	{ "GL1", "Glover", 1, "☘ Glover +1" },
+	{ "GL10", "Glover", 10, "☘ Glover +10" },
+	{ "GL100", "Glover", 100, "☘ Glover +100" },
+}
+local UPGRADE_NAMES = {
+	{ "Size", "🌳 Garden size (next step)" },
+	{ "Decor", "🌸 More decorations (next step)" },
+	{ "PetSlot", "🐾 Pet slot (+1)" },
+	{ "BuildSlot", "🔨 Build slot (+1)" },
+	{ "EggNest", "🥚 Egg nest (+1)" },
+	{ "BoxSpot", "📦 Box spot (+1)" },
+}
+
+local function giveAdd(list, cat, id, name, rarity, icon)
+	table.insert(list, { C = cat, I = id, N = tostring(name), R = rarity, S = icon })
+end
+
+local function sortedDecor()
+	local ids = {}
+	for id, def in ctx.DecorTypes.Defs do
+		if type(def) == "table" then
+			table.insert(ids, id)
+		end
+	end
+	table.sort(ids, function(a, b)
+		local oa, ob = ctx.DecorTypes.Defs[a].Order or 0, ctx.DecorTypes.Defs[b].Order or 0
+		if oa ~= ob then
+			return oa < ob
+		end
+		return a < b
+	end)
+	return ids
+end
+
+local function boxConfig()
+	if ctx.DecorBoxConfig then
+		return ctx.DecorBoxConfig
+	end
+	local ok, m = pcall(function()
+		return require(game:GetService("ReplicatedStorage"):WaitForChild("LeafRush"):WaitForChild("DecorBoxConfig"))
+	end)
+	return if ok and type(m) == "table" then m else nil
+end
+
+function AdminService.GiveCatalog()
+	if giveCatalogCache then
+		return giveCatalogCache
+	end
+	local out = {}
+	local TC = ctx.ToolConfig
+	-- brooms
+	for _, id in ctx.BroomTypes.Order do
+		local def = ctx.BroomTypes.Defs[id]
+		if def then
+			giveAdd(out, "Brooms", id, def.Display or id, def.Rarity, def.Icon)
+		end
+	end
+	-- tools (grass tools + helpers)
+	for _, list in { TC.GrassOrder, TC.HelperOrder } do
+		for _, id in list do
+			local def = TC.Def(id)
+			if def then
+				giveAdd(out, "Tools", id, def.Display or id, def.Rarity, def.Icon)
+			end
+		end
+	end
+	-- one-use items (and, apart, the toys that boost pets)
+	for _, id in TC.ConsumableOrder do
+		local def = TC.Consumables[id]
+		if def then
+			giveAdd(out, if def.PetTarget then "Toys" else "Items", id, def.Display or id, def.Rarity, def.Icon)
+		end
+	end
+	-- trees (saplings)
+	for _, id in ctx.TreeTypes.Order do
+		local def = ctx.TreeTypes.Get(id)
+		if def then
+			giveAdd(out, "Trees", id, def.Display or id, def.Rarity, nil)
+		end
+	end
+	-- buildings (+ collection zone) and cosmetics
+	giveAdd(out, "Buildings", "CollectionZone", "Collection Zone", "Common", nil)
+	for _, id in sortedDecor() do
+		local def = ctx.DecorTypes.Defs[id]
+		if not def.FriendOnly then
+			if ctx.DecorTypes.IsCosmetic(def) then
+				giveAdd(out, "Cosmetics", id, def.Display or id, def.Rarity, nil)
+			else
+				giveAdd(out, "Buildings", id, def.Display or id, def.Rarity, nil)
+			end
+		end
+	end
+	-- cosmetic boxes
+	local BC = boxConfig()
+	if BC and BC.Boxes and BC.Order then
+		for _, id in BC.Order do
+			local def = BC.Boxes[id]
+			if def then
+				giveAdd(out, "Boxes", id, def.Display or id, def.Rarity, def.Icon)
+			end
+		end
+	end
+	-- eggs
+	for _, id in ctx.PetConfig.EggOrder do
+		local def = ctx.PetConfig.Eggs[id]
+		if def then
+			giveAdd(out, "Eggs", id, def.Display or id, def.Rarity, "🥚")
+		end
+	end
+	-- resources (spawned in the garden, as the GIVE ITEM section does)
+	for _, id in ctx.ResourceTypes.Order do
+		local def = ctx.ResourceTypes[id]
+		if type(def) == "table" then
+			giveAdd(out, "Resources", id, def.Display or id, def.Rarity, def.Icon)
+		end
+	end
+	-- currencies
+	for _, m in MONEY_STEPS do
+		giveAdd(out, "Currencies", m[1], m[4], nil, nil)
+	end
+	-- garden upgrades and islands
+	for _, u in UPGRADE_NAMES do
+		giveAdd(out, "Upgrades", u[1], u[2], nil, nil)
+	end
+	for i, t in ctx.IslandConfig.Tiers do
+		giveAdd(out, "Islands", tostring(i), (t.Icon or "🏝") .. " " .. (t.Display or ("Island " .. i)), nil, nil)
+	end
+	giveCatalogCache = out
+	return out
+end
+
+local function countRecords(data, field, value)
+	local n = 0
+	for _, t in { data.Plot.Objects, data.Plot.Stored } do
+		if type(t) == "table" then
+			for _, rec in t do
+				if type(rec) == "table" and rec[field] == value then
+					n += 1
+				end
+			end
+		end
+	end
+	return n
+end
+
+local function storedChanged(player)
+	if ctx.BuildService and ctx.BuildService.PublishSlots then
+		ctx.BuildService.PublishSlots(player)
+	end
+	if ctx.PresetService and ctx.PresetService.Publish then
+		ctx.PresetService.Publish(player)
+	end
+end
+
+function AdminService.GiveThing(player, cat, id, amount, variant, level, who)
+	local data = ctx.PlayerDataService.Get(player)
+	if not data then
+		return false, "Your data isn't loaded yet"
+	end
+	if type(cat) ~= "string" or type(id) ~= "string" or #id > 40 then
+		return false, "Bad request"
+	end
+	local n = wholeNumber(amount, 1, 100, 1)
+	who = who or "server"
+	if cat == "Brooms" then
+		local def = ctx.BroomTypes.Defs[id]
+		if not def or not table.find(ctx.BroomTypes.Order, id) then
+			return false, "Unknown broom"
+		end
+		if data.Brooms.Owned[id] then
+			return false, "You already own it"
+		end
+		data.Brooms.Owned[id] = ctx.BroomTypes.NewOwned()
+		data.Discovered.Brooms[id] = true
+		data.Brooms.Equipped = id -- (as when it is bought: it goes into your hands)
+		data.Equipment.Equipped.Broom = id
+		ctx.BroomSystem.GiveTool(player)
+		addLog(who, "gave a broom: " .. id)
+		return true, "🛠 " .. (def.Display or id) .. " is yours!"
+	elseif cat == "Tools" then
+		local TC = ctx.ToolConfig
+		local kind = TC.KindOf(id)
+		if kind ~= "Grass" and kind ~= "Helper" then
+			return false, "Unknown tool"
+		end
+		local def = TC.Def(id)
+		if data.Tools.Owned[id] then
+			return false, "You already own it"
+		end
+		data.Tools.Owned[id] = true
+		if kind == "Grass" then
+			data.Tools.Grass = id
+		end
+		if id == "Trimmer" then
+			data.Tools.Battery = TC.Trimmer(data.Tools.Up.Trimmer).Battery
+		end
+		ctx.ToolService.GiveTools(player)
+		ctx.ToolService.Publish(player)
+		addLog(who, "gave a tool: " .. id)
+		return true, "🛠 " .. (def.Display or id) .. " is yours!"
+	elseif cat == "Items" or cat == "Toys" then
+		local def = ctx.ToolConfig.Consumables[id]
+		if not def then
+			return false, "Unknown item"
+		end
+		local made = ctx.ToolService.GiveItem(player, id, n)
+		addLog(who, "gave " .. made .. " × " .. id)
+		return made > 0, string.format("🛠 %d × %s given", made, def.Display or id)
+	elseif cat == "Trees" then
+		local def = ctx.TreeTypes.Get(id)
+		if not def then
+			return false, "Unknown tree"
+		end
+		n = math.min(n, 50)
+		if def.Max then
+			n = math.min(n, def.Max - countRecords(data, "TreeType", id))
+			if n < 1 then
+				return false, "You have the most of that tree already"
+			end
+		end
+		for _ = 1, n do
+			ctx.BuildService.Grant(player, id, "", false, true)
+		end
+		addLog(who, "gave " .. n .. " sapling(s): " .. id)
+		return true, string.format("🛠 %d × %s sapling — Inventory · TREES", n, def.Display or id)
+	elseif cat == "Buildings" or cat == "Cosmetics" then
+		local record, def
+		n = math.min(n, 50)
+		if id == "CollectionZone" and cat == "Buildings" then
+			def = { Display = "Collection Zone" }
+			n = math.min(n, ctx.Economy.MaxZones - countRecords(data, "Type", "CollectionZone"))
+			local size = ctx.Config.Plot.CellSize
+			record = { Type = "CollectionZone", X = 0, Z = 0, Rot = 0, SizeX = size, SizeZ = size, Spent = 0 }
+		else
+			def = ctx.DecorTypes.Get(id)
+			if not def or def.FriendOnly or ctx.DecorTypes.IsCosmetic(def) ~= (cat == "Cosmetics") then
