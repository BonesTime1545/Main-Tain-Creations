+-- ===== v2.63 (isles): pure helpers (tested by tests/extra/isles_test.lua; no Roblox API in here) =====
+-- BEGIN isles pure
+local CELL_ROW = 2048
+local function cellKey(i, j)
+	return (i + 1024) * CELL_ROW + (j + 1024)
+end
+
+-- rectangles {i0, i1, j0, j1} (inclusive) that tile the cells of the box (i0, j0, ni, nj) for which has(i, j) is true
+local function cellRects(has, i0, j0, ni, nj)
+	local rects, open = {}, {}
+	for j = j0, j0 + nj - 1 do
+		local nextOpen = {}
+		local i = i0
+		while i < i0 + ni do
+			if has(i, j) then
+				local a = i
+				while i + 1 < i0 + ni and has(i + 1, j) do
+					i += 1
+				end
+				local k = a .. ":" .. i
+				local r = open[k]
+				if r then
+					r[4] = j
+				else
+					r = { a, i, j, j }
+					table.insert(rects, r)
+				end
+				nextOpen[k] = r
+			end
+			i += 1
+		end
+		open = nextOpen
+	end
+	local out = {}
+	for _, r in rects do
+		table.insert(out, { i0 = r[1], i1 = r[2], j0 = r[3], j1 = r[4] })
+	end
+	return out
+end
+
+-- one pass: drop the cells that touch at most one other cell of the set (single blocks / tips that stick out)
+local function pruneSpurs(keep)
+	local drop = {}
+	for k in keep do
+		local c = (if keep[k + 1] then 1 else 0) + (if keep[k - 1] then 1 else 0) + (if keep[k + CELL_ROW] then 1 else 0) + (if keep[k - CELL_ROW] then 1 else 0)
+		if c <= 1 then
+			drop[k] = true
+		end
+	end
+	local n = 0
+	for k in drop do
+		keep[k] = nil
+		n += 1
+	end
+	return n
+end
+
+-- how far a bridge deck has to be lengthened so that its last `window` studs lie on solid ground at every lateral sample.
+-- covered(w, u) -> bool: is the island top under lateral offset w, u studs beyond the deck's tip (u < 0 = under the deck)?
+-- Returns 0 when the deck already touches (nothing to do), else the extension + `extra` studs; nil = no ground within `cap`.
+local function bridgeExtension(covered, laterals, window, cap, extra)
+	local function ok(ext)
+		for _, w in laterals do
+			local u = ext - window
+			while u <= ext + 1e-6 do
+				if not covered(w, u) then
+					return false
+				end
+				u += 0.5
+			end
+		end
+		return true
+	end
+	if ok(0) then
+		return 0
+	end
+	local ext = 0.5
+	while ext <= cap do
+		if ok(ext) then
+			return ext + extra
+		end
+		ext += 0.5
+	end
+	return nil
+end
+-- END isles pure
+
+-- v2.63 (isles): the island BODY is EARTH ONLY. Every part of an island's Underside (Dirt / Rock layers) takes the colour of
+-- the Earth block, the Hanging stalactites are removed, and the layers are trimmed to a clean silhouette: working top-down
+-- on the 4-stud lattice of the body, a layer may only cover cells that the layer above (the lawn for the first one) covers,
+-- and single blocks / tips that touch at most one other block of their layer are dropped. Runs once per island at server
+-- start, BEFORE the diagonal islands are turned and BEFORE BlockService deepens / carves them.
+local function earthColor()
+	local bc = ctx.BlockConfig
+	local d = bc and bc.Types and bc.Types.D
+	return if d and d.Color then d.Color else Color3.fromRGB(124, 92, 62)
+end
+
+local function footprint(p, ox, oz)
+	local cf = p.CFrame
+	if math.abs(cf.UpVector.Y) < 0.999 or math.abs(cf.RightVector.X) < 0.999 then
+		return nil
+	end
+	local s, pos = p.Size, cf.Position
+	local fi, fj = (pos.X - s.X / 2 - ox) / 4, (pos.Z - s.Z / 2 - oz) / 4
+	local ni, nj = s.X / 4, s.Z / 4
+	local i0, j0, ci, cj = math.round(fi), math.round(fj), math.round(ni), math.round(nj)
+	if math.abs(fi - i0) > 0.05 or math.abs(fj - j0) > 0.05 or math.abs(ni - ci) > 0.05 or math.abs(nj - cj) > 0.05 or ci < 1 or cj < 1 then
+		return nil
+	end
+	return i0, j0, ci, cj
+end
+
+local function shapeBody(holder, earth)
+	if holder:GetAttribute("LRBodyShaped") then
+		return
+	end
+	local grass, under = holder:FindFirstChild("Grass"), holder:FindFirstChild("Underside")
+	if not grass or not under then
+		return
+	end
+	holder:SetAttribute("LRBodyShaped", true)
+	local ox, oz
+	local layers, tops = {}, {}
+	for _, d in under:GetDescendants() do
+		if d:IsA("BasePart") then
+			if d.Name == "Hanging" then
+				d:Destroy()
+			else
+				d.Color = earth
+				d.Material = Enum.Material.Plastic
+				if not ox and d.Name == "Dirt" then
+					ox, oz = (d.Position.X - d.Size.X / 2) % 4, (d.Position.Z - d.Size.Z / 2) % 4
+				end
+				local top = math.round((d.Position.Y + d.Size.Y / 2) * 2)
+				if not layers[top] then
+					layers[top] = {}
+					table.insert(tops, top)
+				end
+				table.insert(layers[top], d)
+			end
+		end
+	end
+	if not ox then
+		return
+	end
+	local allowed = {}
+	for _, g in grass:GetDescendants() do
+		if g:IsA("BasePart") and g.Name == "Grass" then
+			local i0, j0, ni, nj = footprint(g, ox, oz)
+			if i0 then
+				for i = i0, i0 + ni - 1 do
+					for j = j0, j0 + nj - 1 do
+						allowed[cellKey(i, j)] = true
+					end
+				end
+			end
+		end
+	end
+	table.sort(tops, function(a, b)
+		return a > b
+	end)
+	for n, top in tops do
+		local items, keep = {}, {}
+		for _, p in layers[top] do
+			local i0, j0, ni, nj = footprint(p, ox, oz)
+			if i0 then
+				table.insert(items, { p, i0, j0, ni, nj })
+				for i = i0, i0 + ni - 1 do
+					for j = j0, j0 + nj - 1 do
+						local k = cellKey(i, j)
+						if allowed[k] then
+							keep[k] = true
+						end
+					end
+				end
+			end
+		end
+		if n > 1 then
+			pruneSpurs(keep)
+		end
+		local function has(i, j)
+			return keep[cellKey(i, j)] == true
+		end
+		for _, it in items do
+			local p, i0, j0, ni, nj = it[1], it[2], it[3], it[4], it[5]
+			local rects = cellRects(has, i0, j0, ni, nj)
+			local r1 = rects[1]
+			if #rects == 0 then
+				p:Destroy()
+			elseif not (#rects == 1 and r1.i0 == i0 and r1.i1 == i0 + ni - 1 and r1.j0 == j0 and r1.j1 == j0 + nj - 1) then
+				local y, sy, parent = p.Position.Y, p.Size.Y, p.Parent
+				for k, r in rects do
+					local q = if k == 1 then p else p:Clone()
+					local wi, wj = r.i1 - r.i0 + 1, r.j1 - r.j0 + 1
+					q.Size = Vector3.new(wi * 4, sy, wj * 4)
+					q.CFrame = CFrame.new(ox + 2 * (r.i0 + r.i1 + 1), y, oz + 2 * (r.j0 + r.j1 + 1))
+					q.Parent = parent
+				end
+			end
+		end
+		allowed = keep
+	end
+end
+
+local function shapeBodies(map)
+	local earth = earthColor()
+	local gardens = map:FindFirstChild("GardenIslands")
+	local cfg = ctx.Config
+	for i = 1, (cfg.Plot and cfg.Plot.Count) or 6 do
+		local model = gardens and gardens:FindFirstChild("GardenIsland" .. i)
+		if model then
+			local ok, err = pcall(shapeBody, model, earth)
+			if not ok then
+				warn("[LeafRush] island body " .. i .. ": " .. tostring(err))
+			end
+		end
+	end
+	for _, name in { "HubIsland", "EventIsland" } do
+		local isle = map:FindFirstChild(name)
+		local ground = isle and isle:FindFirstChild("Ground")
+		if ground then
+			local ok, err = pcall(shapeBody, ground, earth)
+			if not ok then
+				warn("[LeafRush] island body " .. name .. ": " .. tostring(err))
+			end
+		end
+	end
+end
