+						d:SetAttribute("OrigC", d.CanCollide)
+					end
+					d.Transparency = if on then d:GetAttribute("OrigT") else 1
+					d.CanCollide = if on then d:GetAttribute("OrigC") else false
+					d.CanTouch = on
+				elseif d:IsA("Decal") or d:IsA("Texture") then
+					if d:GetAttribute("OrigT") == nil then
+						d:SetAttribute("OrigT", d.Transparency)
+					end
+					d.Transparency = if on then d:GetAttribute("OrigT") else 1
+				elseif d:IsA("ProximityPrompt") then
+					d.Enabled = false -- (v2.52: every prompt of these models stays off on the server: the OWNER's client turns its own on)
+				elseif d:IsA("ClickDetector") then
+					d.MaxActivationDistance = 0
+				elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Beam") or d:IsA("Trail") then
+					(d :: any).Enabled = on
+				end
+			end
+		end
+	end
+end
