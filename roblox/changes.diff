+-- v2.63 (isles): every bridge end must lie ON an island top (hub, garden island, event island). The ends of the turned
+-- diagonal islands stopped 5 studs short of the rim: the deck is lengthened (flat clones of its last plank, beams, rails,
+-- end posts; the end lamps move with it) until it overlaps the grass by >= 3 studs. Ends that already touch are left alone.
+local SEAT_WINDOW, SEAT_EXTRA, SEAT_CAP = 2.5, 0.5, 20
+local SEAT_LATERALS = { -4.5, -3, -1.5, 0, 1.5, 3, 4.5 }
+
+local function seatBridge(bridge, tops)
+	if bridge:GetAttribute("LRSeated") then
+		return
+	end
+	local planks, beams, posts, rails, lows = {}, {}, {}, {}, {}
+	local pf = bridge:FindFirstChild("Planks")
+	local rf = bridge:FindFirstChild("Railing")
+	local lf = bridge:FindFirstChild("Lamps")
+	if not pf then
+		return
