+-- v2.62 (straight): turn the baked body of the diagonal garden islands upright (see Config.IslandBodyRotation).
+-- Only the island's own pieces move (Grass, Underside, Details: plain anchored Parts); the yard (Workspace.LeafRush.Plots),
+-- the quest giver / upgrade sign (they stand in the yard's frame) and the bridges keep their place. The turned island
+-- ends ~7 studs short of its bridge (the bridge was cut for the diagonal corner): a landing pad closes that gap.
+local function addLanding(map, model, index, c, ang)
+	local frame = CFrame.new(c) * CFrame.Angles(0, ang, 0)
+	local inv = frame:Inverse()
+	local bridges = map:FindFirstChild("Bridges")
+	local bridge = bridges and bridges:FindFirstChild("BridgeToGarden" .. index)
+	if not bridge then
+		return
+	end
+	-- the bridge's first plank (plot-local z; the bridge lies along the yard's +Z axis)
+	local startZ = math.huge
+	for _, d in bridge:GetDescendants() do
+		if d:IsA("BasePart") and d.Name == "Plank" then
+			startZ = math.min(startZ, inv:PointToObjectSpace(d.Position).Z - d.Size.Z / 2)
+		end
+	end
+	if startZ == math.huge then
+		return
+	end
+	-- the island's rim on that axis (plot-local z of the outermost grass voxel in front of the gate)
+	local edgeZ, grassSrc, dirtSrc = -math.huge, nil, nil
+	local grassDist, dirtDist = math.huge, math.huge
+	local goal = Vector3.new(0, 0, startZ)
+	local grass = model:FindFirstChild("Grass")
+	local under = model:FindFirstChild("Underside")
+	if grass then
+		for _, d in grass:GetDescendants() do
+			if d:IsA("BasePart") and d.Name == "Grass" then
+				local lp = inv:PointToObjectSpace(d.Position)
+				if math.abs(lp.X) < 8 and lp.Z > 30 then
+					edgeZ = math.max(edgeZ, lp.Z + d.Size.Z / 2)
+				end
+				local dd = (Vector3.new(lp.X, 0, lp.Z) - goal).Magnitude
+				if dd < grassDist then
+					grassDist, grassSrc = dd, d
+				end
+			end
+		end
+	end
+	if under then
+		for _, d in under:GetDescendants() do
+			if d:IsA("BasePart") and d.Name == "Dirt" then
+				local lp = inv:PointToObjectSpace(d.Position)
+				local dd = (Vector3.new(lp.X, 0, lp.Z) - goal).Magnitude
+				if dd < dirtDist then
+					dirtDist, dirtSrc = dd, d
+				end
+			end
+		end
+	end
+	local z1 = startZ + 1.5 -- (a little under the first plank)
+	if not grassSrc or edgeZ == -math.huge or z1 - edgeZ < 0.5 then
+		return
+	end
+	local width, len = 16, z1 - edgeZ
+	local zc = (edgeZ + z1) / 2
+	local function pad(src, parent, thick, topY)
+		local b = src:Clone()
+		b.Size = Vector3.new(width, thick, len)
+		b.CFrame = frame * CFrame.new(0, topY - thick / 2, zc)
+		b:SetAttribute("LRLanding", true)
+		b.Parent = parent
+		return b
+	end
+	pad(grassSrc, grassSrc.Parent, 2, 0) -- the lawn: top at y 0 like the rest of the island
+	if dirtSrc then
+		pad(dirtSrc, dirtSrc.Parent, 6, -2) -- the earth below it (bottom -8: above the layer that BlockService deepens)
+	end
+end
