+	return if type(id) == "number" and id > 0 then id else nil
+end
+
+-- the Robux price of a named item (its fixed price), else the formula price of `money`
+function R.ItemPrice(name, money)
+	local e = R.ItemProduct(name)
+	if e then
+		return e.Robux
+	end
+	return R.ForMoney(money)
+end
+
+-- receipt side: product id -> item name, entry (nil when no item owns that id)
+function R.ItemOfProduct(productId)
+	if type(productId) ~= "number" or productId <= 0 then
+		return nil
+	end
+	for name, e in R.ItemProducts do
+		if e.Id == productId then
+			return name, e
+		end
+	end
+	return nil
