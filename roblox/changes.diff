+---------------------------------------------------------------- v2.51 island DECOR
+--[[
+	Every island look has its own SCENERY built from toy bricks (Plastic + studs) around the rim of the island,
+	OUTSIDE the garden's 100x100 yard: rocks, crystals, mushrooms, snowmen, lava pools, palms, clouds … plus
+	looping ambient particles (fireflies, snow, embers, petals, spores, stars …) and a few warm lights.
+	It lives in a "Decor" folder inside the island model and is rebuilt by ApplyLook / ApplyDecor.
+	The particle emitters carry the attributes IslandFX = true and BaseRate: the CLIENT turns them down /
+	off with the settings "Show effects" and "Low graphics" (LeafRushClient).
+]]
+local STUDS = Enum.SurfaceType.Studs
+local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
+local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
+local function rgb(r, g, b)
+	return Color3.fromRGB(r, g, b)
+end
+local siteCache = {} -- [index] = { Sites, Boxes }
+
+-- the places on the island where scenery may stand: on grass, OUTSIDE the yard (|x|,|z| >= 55 in the yard's
+-- frame), away from the bridge landing. E = distance to the island's edge (4 = the outermost voxel)
+local function islandSites(index, model)
+	local cached = siteCache[index]
+	if cached then
+		return cached
+	end
+	local boxes = {}
+	for _, d in model:GetDescendants() do
+		if d:IsA("BasePart") and d.Name == "Grass" and d.Transparency < 0.9 then
+			local p, s = d.Position, d.Size
+			table.insert(boxes, { p.X - s.X / 2 - 0.05, p.X + s.X / 2 + 0.05, p.Z - s.Z / 2 - 0.05, p.Z + s.Z / 2 + 0.05 })
+		end
+	end
+	local function onGrass(x, z)
+		for _, b in boxes do
+			if x >= b[1] and x <= b[2] and z >= b[3] and z <= b[4] then
+				return true
+			end
+		end
+		return false
+	end
+	local c = ctx.Config.IslandCenter(index)
+	local rot = ctx.Config.IslandRotation(index)
+	local cs, sn = math.cos(rot), math.sin(rot)
+	local sites = {}
+	local axes = { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) }
+	for i = -18, 17 do
+		for j = -18, 17 do
+			local dx, dz = i * 4 + 2, j * 4 + 2
+			local x, z = c.X + dx, c.Z + dz
+			if onGrass(x, z) then
+				local lx, lz = dx * cs - dz * sn, dx * sn + dz * cs
+				if math.max(math.abs(lx), math.abs(lz)) >= 55 and not (lz > 36 and math.abs(lx) < 14) then
+					local e, out = 24, axes[1]
+					for d = 4, 20, 4 do
+						local found = false
+						for _, a in axes do
+							if not onGrass(x + a.X * d, z + a.Z * d) then
+								e, out, found = d, a, true
+								break
+							end
+						end
+						if found then
+							break
+						end
+					end
+					table.insert(sites, { P = Vector3.new(x, 0, z), Lx = lx, Lz = lz, E = e, Out = out })
+				end
+			end
+		end
+	end
+	cached = { Sites = sites, Boxes = boxes }
+	siteCache[index] = cached
+	return cached
+end
+
+local function newScene(index, folder, tierIndex, sites)
+	local E: any = {}
+	E.rng = Random.new(index * 7919 + tierIndex * 104729)
+	E.c = ctx.Config.IslandCenter(index)
+	E.rot = ctx.Config.IslandRotation(index)
+	E.used = {}
+	E.lights = 0
+	local rng = E.rng
+	E.shuffled = table.clone(sites)
+	for k = #E.shuffled, 2, -1 do
+		local j = rng:NextInteger(1, k)
+		E.shuffled[k], E.shuffled[j] = E.shuffled[j], E.shuffled[k]
+	end
+
+	function E.r(a, b)
+		return rng:NextNumber(a, b)
+	end
+	function E.add(name, size, cf, color, opt)
+		opt = opt or {}
+		local p = Instance.new("Part")
+		p.Name = name
+		p.Anchored = true
+		p.CanCollide = false
+		p.CanQuery = false
+		p.CanTouch = false
+		p.CastShadow = false
+		p.TopSurface = Enum.SurfaceType.Smooth
+		p.BottomSurface = Enum.SurfaceType.Smooth
+		p.Size = size
+		p.CFrame = cf
+		p.Color = color
+		local mat = opt.Material or Enum.Material.Plastic
+		p.Material = mat
+		if opt.Shape then
+			p.Shape = opt.Shape
+		end
+		if opt.Transparency then
+			p.Transparency = opt.Transparency
+		end
+		if mat == Enum.Material.Plastic then
+			p.TopSurface, p.BottomSurface, p.FrontSurface, p.BackSurface, p.LeftSurface, p.RightSurface = STUDS, STUDS, STUDS, STUDS, STUDS, STUDS
+		end
+		p.Parent = folder
+		return p
+	end
+	function E.light(part, color, range, brightness)
+		if E.lights >= 7 then
+			return
+		end
+		E.lights += 1
+		local l = Instance.new("PointLight")
+		l.Color = color
+		l.Range = range
+		l.Brightness = brightness
+		l.Shadows = false
+		l.Parent = part
+	end
+	-- a random free site: pred(site) -> bool, gap = the room it needs round it
+	function E.pick(pred, gap)
+		local list = E.shuffled
+		for k = 1, #list do
+			local s = list[k]
+			if not pred or pred(s) then
+				local ok = true
+				for _, u in E.used do
+					local d = u.P - s.P
+					if d.X * d.X + d.Z * d.Z < ((gap + u.Gap) / 2) ^ 2 then
