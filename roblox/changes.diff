+					local lp = plotCF:PointToObjectSpace(cf.Position)
+					if math.abs(lp.X) < half + 0.5 and math.abs(lp.Z) < half + 0.5 and lp.Y > bottom then
+						table.insert(s.Carved, { Part = p, T = p.Transparency, C = p.CanCollide, Q = p.CanQuery, Size = sz, CF = cf })
+						p:SetAttribute("LRCarved", true)
+						p.Transparency, p.CanCollide, p.CanQuery = 1, false, false
