+---------------------------------------------------------------- v2.50 the island under a pit
+--[[
+	The garden stands on a BAKED sky island (Map.GardenIslands.GardenIsland<n>: voxel parts
+	"Grass" y -2…0, "Underside" layers below, "Details" flowers / tufts). A pit under the
+	floor would be dug INTO those solid parts, so while any cell is dug (PitMode) the parts
+	that touch the garden's column (down to the bed of the pit) are hidden (no collision,
+	invisible; the ones that reach deeper are shrunk to their part below the bed) and the area
+	they covered OUTSIDE the garden is filled again with plot-aligned bricks of the same
+	colour (the ring around the garden), so the island looks whole. Everything is put back
+	when the last hole is filled / the owner leaves.
+]]
+local function islandModel(plot)
+	local root = workspace:FindFirstChild("LeafRush")
+	local map = root and root:FindFirstChild("Map")
+	local gardens = map and map:FindFirstChild("GardenIslands")
+	return gardens and gardens:FindFirstChild("GardenIsland" .. plot.Index)
+end
+
+-- v2.61 (ground): make the island's body deeper under the yard (once per island; no new parts, see BlockMath.DeepenBox)
+local function deepenIsland(model)
+	local under = model and model:FindFirstChild("Underside")
+	if not under or model:GetAttribute("LRDeep") then
+		return
+	end
+	model:SetAttribute("LRDeep", true)
+	local delta, wide = BM.IslandDeepen(), BM.IslandWideBottom
+	for _, p in under:GetDescendants() do
+		if p:IsA("BasePart") then
+			local cf, sz = p.CFrame, p.Size
+			local dy, dh = BM.DeepenBox(cf.Position.Y - sz.Y / 2, delta, wide)
+			if dy ~= 0 then
+				if dh ~= 0 then
+					p.Size = Vector3.new(sz.X, sz.Y + dh, sz.Z)
+				end
+				p.CFrame = cf + Vector3.new(0, dy, 0)
+			end
+		end
+	end
+end
+
+local function deepenAllIslands()
+	local root = workspace:FindFirstChild("LeafRush")
+	local map = root and root:FindFirstChild("Map")
+	local gardens = map and map:FindFirstChild("GardenIslands")
+	if not gardens then
+		return
+	end
+	for i = 1, ctx.Config.Plot.Count or 6 do
+		pcall(deepenIsland, gardens:FindFirstChild("GardenIsland" .. i))
+	end
+end
