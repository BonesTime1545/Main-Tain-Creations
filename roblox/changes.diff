+function GemShopUI:OffersRefresh()
+	local w = self.ow
+	if not w or not w.open then
+		return
+	end
+	local K, RC = self.UIKit, self.RobuxConfig
+	w.Clear()
+	local list = w.list
+	local st = self:_offerState()
+	local order = 0
+	local function nextOrder()
+		order += 1
+		return order
+	end
+	if w.tab == "Bundles" then
+		K.card(list, nextOrder(), { Title = "Bundles & Starter Packs", Icon = "🎁", MinHeight = 50, Accent = K.GOLD, Body = "Everything in one box — much cheaper than buying it piece by piece. One-time packs can only be bought once." })
+		for _, def in RC.Offers do
+			if def.Kind == "Bundle" then
+				self:_offerCard(list, nextOrder(), def, st)
+			end
+		end
+	else
+		local tier = tonumber(self.player:GetAttribute("SupporterTier")) or 0
+		K.card(list, nextOrder(), { Title = if tier >= 2 then "🌟 Big Supporter — thank you!" elseif tier >= 1 then "⭐ Supporter — thank you!" else "Support the game", Icon = "⭐", MinHeight = 50, Accent = K.GOLD, Body = "Every purchase here helps the game grow. Thank you for playing!" })
+		self:_offerCard(list, nextOrder(), RC.OfferById.Double, st)
+		-- the boosts that run right now
+		local now = workspace:GetServerTimeNow()
+		local running = {}
+		for _, key in RC.OfferBoostKeys do
+			local b = RC.OfferBoosts[key]
+			local untilT = tonumber(self.player:GetAttribute(if b.Kind == "Money" then "BoostMoneyUntil" elseif b.Kind == "Luck" then "BoostLuckUntil" else "BoostXPUntil")) or 0
+			if untilT > now and (b.Kind ~= "Money" or key == (if (self.player:GetAttribute("BoostMoneyMult") or 1) >= 3 then "Money3" else "Money2")) then
+				local mins = math.ceil((untilT - now) / 60)
+				table.insert(running, string.format("%s%s  %d:%02d", b.Icon, if b.Mult then "×" .. b.Mult else "", mins // 60, mins % 60))
+			end
+		end
+		if #running > 0 then
+			K.card(list, nextOrder(), { Title = "Running now", Icon = "⚡", MinHeight = 50, Accent = K.GOOD, Body = table.concat(running, "   ") })
+		end
+		for _, g in OFFER_GROUPS do
+			local any = false
+			for _, def in RC.Offers do
+				if def.Group == g[1] then
+					if not any then
+						any = true
+						K.heading(list, nextOrder(), g[2])
+					end
+					self:_offerCard(list, nextOrder(), def, st)
+				end
+			end
+		end
+	end
+	if RunService:IsStudio() and RC.StudioSimulate then
+		K.card(list, nextOrder(), { Title = "Studio test mode", Icon = "🛠", MinHeight = 50, Body = "In Studio a purchase is simulated: you get everything without a real Robux charge (until a product ID is pasted into RobuxConfig.OfferProducts)." })
+	end
+end
