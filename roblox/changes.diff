+	local a0 = Instance.new("Attachment")
+	a0.Position = Vector3.new(0, size * 0.4, 0)
+	a0.Parent = rock
+	local a1 = Instance.new("Attachment")
+	a1.Position = Vector3.new(0, -size * 0.4, 0)
+	a1.Parent = rock
+	local trail = Instance.new("Trail")
+	trail.Attachment0 = a0
+	trail.Attachment1 = a1
+	trail.Lifetime = 0.5
+	trail.LightEmission = if lava then 1 else 0
+	trail.Color = if lava then ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20)) else ColorSequence.new(Color3.fromRGB(190, 180, 170), Color3.fromRGB(90, 85, 80))
